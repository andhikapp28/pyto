---
// Animasi #2 (plan/bab-15-animasi.md) — Centerpiece 1: sebuah lembar Excel
// bergaris-garis tampil di kiri. Baris judul kolom berkedip abu-abu lalu
// memudar (dilewati oleh min_row=2). Tiap baris data "terangkat" jadi
// lemari berlabel mini (echo dictionary Bab 11) yang melayang ke kanan dan
// berbaris masuk ke keranjang bernomor (echo list Bab 8). Komponen ilustrasi
// statis (data contoh generik). Sekali jalan saat terlihat, boleh diulang
// lewat hover/klik/fokus.
---

<div
  class="etl-demo"
  data-anim="etl-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi baris Excel berubah jadi list berisi dictionary"
>
  <div class="etl-demo__code">
    <div class="etl-demo__line">
      <span class="tok-var">sheet</span>.<span class="tok-fn">iter_rows</span>(min_row=2, values_only=<span
        class="tok-kw">True</span
      >)
    </div>
  </div>

  <div class="etl-demo__stage">
    <div class="etl-demo__sheet">
      <div class="etl-demo__row etl-demo__row--header">
        <span>Nama</span><span>Jumlah</span><span>Harga</span>
      </div>
      <div class="etl-demo__row">
        <span>Kopi Sachet</span><span>120</span><span>2500</span>
      </div>
      <div class="etl-demo__row">
        <span>Teh Botol</span><span>60</span><span>4000</span>
      </div>
    </div>

    <span class="etl-demo__arrow" aria-hidden="true">→</span>

    <div class="etl-demo__basket" aria-hidden="true">
      <span class="etl-demo__cabinet etl-demo__cabinet--1">🗂️</span>
      <span class="etl-demo__cabinet etl-demo__cabinet--2">🗂️</span>
      <span class="etl-demo__basket-label">list</span>
    </div>
  </div>
</div>

<p class="etl-demo__hint">
  💡 Baris judul kolom dilewati (<code>min_row=2</code>), tiap baris data jadi satu dictionary di
  dalam sebuah list. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .etl-demo {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 22px 24px;
    cursor: pointer;
  }

  .etl-demo__code {
    background: var(--code-bg);
    border-radius: var(--radius-code);
    padding: 16px 18px;
    font-family: var(--font-code);
    font-size: 13px;
    line-height: 1.85;
    color: var(--code-text);
    overflow-x: auto;
  }

  .etl-demo__line {
    white-space: pre;
  }

  .tok-var {
    color: var(--code-red);
  }

  .tok-fn {
    color: var(--code-blue);
  }

  .tok-kw {
    color: var(--code-purple);
  }

  .etl-demo__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .etl-demo__sheet {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px;
  }

  .etl-demo__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    font-family: var(--font-code);
    font-size: 10px;
    color: var(--ink);
    padding: 2px 4px;
  }

  .etl-demo__row--header {
    background: var(--cloud);
    font-weight: 700;
    border-radius: 3px;
  }

  .etl-demo.is-in .etl-demo__row--header {
    animation: etl-demo-header-fade 0.5s ease 0.4s forwards;
  }

  @keyframes etl-demo-header-fade {
    to {
      opacity: 0.25;
    }
  }

  .etl-demo__arrow {
    font-size: 20px;
    color: var(--slate);
  }

  .etl-demo__basket {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 70px;
    height: 60px;
    border: 2px solid var(--pyto-green);
    border-radius: 8px;
    background: var(--pyto-green-soft);
    justify-content: center;
  }

  .etl-demo__cabinet {
    font-size: 20px;
    opacity: 0;
    transform: translateX(-16px) scale(0.7);
  }

  .etl-demo.is-in .etl-demo__cabinet--1 {
    animation: etl-demo-cabinet-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards;
  }

  .etl-demo.is-in .etl-demo__cabinet--2 {
    animation: etl-demo-cabinet-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s forwards;
  }

  @keyframes etl-demo-cabinet-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .etl-demo__basket-label {
    position: absolute;
    bottom: -18px;
    font-family: var(--font-code);
    font-size: 10px;
    font-weight: 700;
    color: var(--pyto-green-dark);
  }

  .etl-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  .etl-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .etl-demo__row--header,
    .etl-demo__cabinet {
      animation: none !important;
    }

    .etl-demo__row--header {
      opacity: 0.25;
    }

    .etl-demo__cabinet {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .etl-demo__code {
      font-size: 12px;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="etl-demo"]');

  observeOnce(els, (el) => {
    el.classList.add('is-in');
  });

  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
