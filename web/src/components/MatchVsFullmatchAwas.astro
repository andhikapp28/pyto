---
// Animasi #5 (plan/Fase2/bab-18-animasi.md) — kotak "Awas" `re.match()` bukan
// `re.fullmatch()`. Reuse PhoneStencil.astro (echo beat #3) sebagai
// pengingat visual bentuk pola, lalu kontras dua kolom: "✗ re.match()" cuma
// memeriksa bagian DEPAN teks (menyala hijau tanpa peduli sisa teks aneh di
// belakang, digambarkan buram/diabaikan), "✓ re.fullmatch()" memeriksa
// SELURUH teks (menyala merah dengan jujur karena tidak cocok penuh).
// Sekali jalan saat terlihat, boleh diulang lewat hover/klik/keyboard.
import PhoneStencil from './PhoneStencil.astro';
---

<div
  class="mva-demo"
  data-anim="mva-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi kontras re.match dan re.fullmatch"
>
  <PhoneStencil idPrefix="mva" />

  <div class="mva-demo__cols">
    <div class="mva-demo__col mva-demo__col--wrong" id="mva-col-wrong">
      <span class="mva-demo__code">✗ re.match()</span>
      <p class="mva-demo__text">
        <span class="mva-demo__ok">0812-3456-7890</span><span class="mva-demo__ignored">
          (WhatsApp saja ya, jangan telepon)</span
        >
      </p>
      <span class="mva-demo__result mva-demo__result--wrong">✅ "Valid!" <em>(padahal salah!)</em></span>
    </div>

    <div class="mva-demo__col mva-demo__col--right" id="mva-col-right">
      <span class="mva-demo__code">✓ re.fullmatch()</span>
      <p class="mva-demo__text">
        <span class="mva-demo__bad">0812-3456-7890 (WhatsApp saja ya, jangan telepon)</span>
      </p>
      <span class="mva-demo__result mva-demo__result--right">❌ Bukan format yang dikenali</span>
    </div>
  </div>
</div>

<p class="mva-demo__hint">
  💡 <code>re.match()</code> cuma "mengunci" di awal teks — sisa apa pun di belakang diabaikan.
  <code>re.fullmatch()</code> jujur memeriksa sampai akhir. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .mva-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    background: var(--box-awas-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 22px 24px;
    cursor: pointer;
  }

  .mva-demo__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
  }

  .mva-demo__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--white);
    border-radius: 10px;
    padding: 16px;
    opacity: 0;
    transform: translateX(-16px);
  }

  .mva-demo.is-in .mva-demo__col--wrong {
    animation:
      mva-col-in 0.4s ease 0.1s forwards,
      mva-jitter 0.4s ease 0.6s;
  }

  .mva-demo.is-in .mva-demo__col--right {
    animation: mva-col-in 0.4s ease 1.1s forwards;
  }

  @keyframes mva-col-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mva-jitter {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .mva-demo__code {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 13px;
    color: var(--slate);
  }

  .mva-demo__text {
    margin: 0;
    font-family: var(--font-code);
    font-size: 13px;
    line-height: 1.6;
  }

  .mva-demo__ok {
    border-radius: 5px;
    padding: 1px 3px;
    color: var(--ink);
    font-weight: 700;
  }

  .mva-demo.is-in .mva-demo__col--wrong .mva-demo__ok {
    animation: mva-ok-glow 0.35s ease 0.7s forwards;
  }

  @keyframes mva-ok-glow {
    to {
      background: var(--pyto-green-soft);
    }
  }

  .mva-demo__ignored {
    color: var(--slate);
    opacity: 0.45;
  }

  .mva-demo__bad {
    border-radius: 5px;
    padding: 1px 3px;
    color: var(--ink);
  }

  .mva-demo.is-in .mva-demo__col--right .mva-demo__bad {
    animation: mva-bad-glow 0.35s ease 1.7s forwards;
  }

  @keyframes mva-bad-glow {
    to {
      background: var(--box-awas-bg);
      box-shadow: inset 0 0 0 1.5px var(--coral);
    }
  }

  .mva-demo__result {
    font-size: 13px;
    font-weight: 700;
    opacity: 0;
  }

  .mva-demo.is-in .mva-demo__result--wrong {
    animation: mva-result-in 0.3s ease 1s forwards;
    color: #c0392b;
  }

  .mva-demo.is-in .mva-demo__result--right {
    animation: mva-result-in 0.3s ease 2s forwards;
    color: var(--pyto-green-dark);
  }

  @keyframes mva-result-in {
    to {
      opacity: 1;
    }
  }

  .mva-demo__result em {
    font-weight: 400;
    opacity: 0.8;
  }

  .mva-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  .mva-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .mva-demo__col,
    .mva-demo__ok,
    .mva-demo__bad,
    .mva-demo__result {
      animation: none !important;
      opacity: 1;
      transform: none;
    }

    .mva-demo__ok {
      background: var(--pyto-green-soft);
    }

    .mva-demo__bad {
      background: var(--box-awas-bg);
      box-shadow: inset 0 0 0 1.5px var(--coral);
    }
  }

  @media (max-width: 620px) {
    .mva-demo__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="mva-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
