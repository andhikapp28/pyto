---
// Animasi #6 (plan/Fase2/bab-15-animasi.md): kiri "✗ Jangan begini" — baris judul
// kolom ikut masuk ke kalkulator (echo beat #4), kalkulator "tersedak" dan
// menampilkan gelembung TypeError. Kanan "✓ Begini lebih aman" — baris
// judul memudar dilewati dulu (echo beat #2) sebelum kalkulator bekerja
// mulus. Dipakai di dalam <KotakAwas>. Sekali jalan saat terlihat, boleh
// diulang lewat hover/klik/fokus.
---

<div
  class="hra-demo"
  data-anim="hra-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi baris judul kolom ikut kehitung sebagai data"
>
  <div class="hra-demo__code">
    <div class="hra-demo__line"><span class="tok-comment"># ✗ Jangan begini</span></div>
    <div class="hra-demo__line">sheet.iter_rows(values_only=True)</div>
    <div class="hra-demo__line">&nbsp;</div>
    <div class="hra-demo__line"><span class="tok-comment"># ✓ Begini lebih aman</span></div>
    <div class="hra-demo__line">sheet.iter_rows(<span class="tok-fn">min_row=2</span>, values_only=True)</div>
  </div>

  <div class="hra-demo__cols">
    <div class="hra-demo__col">
      <span class="hra-demo__label hra-demo__label--bad">✗ Jangan begini</span>
      <div class="hra-demo__row hra-demo__row--bad">
        <span>Nama</span><span>Jumlah</span><span>Harga</span>
      </div>
      <span class="hra-demo__calc" aria-hidden="true">🧮</span>
      <span class="hra-demo__error">TypeError 💥</span>
    </div>

    <div class="hra-demo__col">
      <span class="hra-demo__label hra-demo__label--good">✓ Begini lebih aman</span>
      <div class="hra-demo__row hra-demo__row--skip">
        <span>Nama</span><span>Jumlah</span><span>Harga</span>
      </div>
      <span class="hra-demo__calc" aria-hidden="true">🧮</span>
      <span class="hra-demo__ok">✅ Aman</span>
    </div>
  </div>
</div>

<style>
  .hra-demo {
    display: flex;
    flex-direction: column;
    gap: 16px;
    cursor: pointer;
  }

  .hra-demo__code {
    background: var(--code-bg);
    border-radius: var(--radius-code);
    padding: 14px 16px;
    font-family: var(--font-code);
    font-size: 12px;
    line-height: 1.75;
    color: var(--code-text);
    overflow-x: auto;
  }

  .hra-demo__line {
    white-space: pre;
  }

  .tok-comment {
    color: var(--code-comment);
  }

  .tok-fn {
    color: var(--code-blue);
  }

  .hra-demo__cols {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hra-demo__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .hra-demo__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
  }

  .hra-demo__label--bad {
    color: var(--coral);
  }

  .hra-demo__label--good {
    color: var(--pyto-green-dark);
  }

  .hra-demo__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    font-family: var(--font-code);
    font-size: 9px;
    background: var(--cloud);
    border-radius: 4px;
    padding: 4px 6px;
    font-weight: 700;
  }

  .hra-demo.is-in .hra-demo__row--bad {
    animation: hra-demo-flow-in 0.4s ease 0.3s forwards;
  }

  .hra-demo.is-in .hra-demo__row--skip {
    animation: hra-demo-fade-skip 0.5s ease 0.3s forwards;
  }

  @keyframes hra-demo-flow-in {
    from {
      transform: translateY(-10px);
    }
    to {
      transform: none;
    }
  }

  @keyframes hra-demo-fade-skip {
    to {
      opacity: 0.3;
    }
  }

  .hra-demo__calc {
    font-size: 22px;
  }

  .hra-demo.is-in .hra-demo__col:first-child .hra-demo__calc {
    animation: hra-demo-shake 0.5s ease 0.9s;
  }

  @keyframes hra-demo-shake {
    0%,
    100% {
      transform: translateX(0) rotate(0deg);
    }
    25% {
      transform: translateX(-4px) rotate(-6deg);
    }
    75% {
      transform: translateX(4px) rotate(6deg);
    }
  }

  .hra-demo__error {
    font-family: var(--font-code);
    font-size: 11px;
    font-weight: 700;
    background: var(--box-awas-bg);
    color: #c0392b;
    border: 1px solid var(--coral);
    border-radius: 999px;
    padding: 3px 10px;
    opacity: 0;
    transform: scale(0.7);
  }

  .hra-demo.is-in .hra-demo__error {
    animation: hra-demo-pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.3s forwards;
  }

  .hra-demo__ok {
    font-family: var(--font-code);
    font-size: 11px;
    font-weight: 700;
    background: var(--pyto-green-soft);
    color: var(--pyto-green-dark);
    border: 1px solid var(--pyto-green);
    border-radius: 999px;
    padding: 3px 10px;
    opacity: 0;
    transform: scale(0.7);
  }

  .hra-demo.is-in .hra-demo__ok {
    animation: hra-demo-pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards;
  }

  @keyframes hra-demo-pop-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hra-demo__row,
    .hra-demo__calc,
    .hra-demo__error,
    .hra-demo__ok {
      animation: none !important;
    }

    .hra-demo__row--skip {
      opacity: 0.3;
    }

    .hra-demo__error,
    .hra-demo__ok {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="hra-demo"]');

  observeOnce(els, (el) => {
    el.classList.add('is-in');
  });

  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
