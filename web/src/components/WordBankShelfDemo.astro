---
// Animasi #2 (plan/bab-19-animasi.md), Centerpiece 1a — kode Langkah 1
// Kotak Inti #1 (kategori_kata, random.choice() dua kali). Tiga rak
// berlabel (hewan/buah/negara — echo lemari berlabel Bab 11) berjajar,
// masing-masing berisi kartu kata. Sebuah tangan menunjuk berpindah-pindah
// lalu berhenti di satu rak (menyala kuning, echo desain "rak & kartu
// terpilih menyala --sunny-yellow"), lalu tangan yang sama menunjuk-nunjuk
// kartu di dalam rak terpilih sampai berhenti di satu kartu (kartu terbang
// keluar + membalik menampilkan kata_rahasia). Sekali jalan saat terlihat,
// boleh diulang lewat hover/klik/keyboard.
// Kata-kata dalam kategori_kata WAJIB persis sama dengan kontrak desain
// (plan/design/bab-19-desain.md) — jangan diganti.
const categories = [
  { key: 'hewan', words: ['gajah', 'jerapah', 'kucing', 'musang'] },
  { key: 'buah', words: ['mangga', 'apel', 'nanas', 'duku'] },
  { key: 'negara', words: ['indonesia', 'jepang', 'brasil', 'mesir'] },
];

const chosenCategory = 0; // "hewan"
const chosenWord = 0; // "gajah"
---

<div
  class="wbs-demo"
  data-anim="wbs-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi memilih kategori lalu kata secara acak"
>
  <span class="wbs-demo__pointer" id="wbs-pointer" aria-hidden="true">👆</span>

  <div class="wbs-demo__shelves">
    {
      categories.map((c, ci) => (
        <div
          class:list={['wbs-demo__shelf', { 'wbs-demo__shelf--chosen': ci === chosenCategory }]}
          id={`wbs-shelf-${ci}`}
        >
          <span class="wbs-demo__shelf-label">{c.key}</span>
          <div class="wbs-demo__cards">
            {
              c.words.map((w, wi) => (
                <span
                  class:list={[
                    'wbs-demo__card',
                    { 'wbs-demo__card--chosen': ci === chosenCategory && wi === chosenWord },
                  ]}
                  id={`wbs-card-${ci}-${wi}`}
                >
                  {ci === chosenCategory ? w : '•••'}
                </span>
              ))
            }
          </div>
        </div>
      ))
    }
  </div>

  <div class="wbs-demo__result">
    <span class="wbs-demo__result-box">
      <span class="wbs-demo__result-label">kategori</span>
      <span class="wbs-demo__result-value">{categories[chosenCategory].key}</span>
    </span>
    <span class="wbs-demo__result-box">
      <span class="wbs-demo__result-label">kata_rahasia</span>
      <span class="wbs-demo__result-value" id="wbs-result-word">{categories[chosenCategory].words[chosenWord]}</span>
    </span>
  </div>
</div>

<p class="wbs-demo__hint">
  💡 <code>random.choice()</code> dipanggil DUA KALI: sekali memilih rak (kategori), sekali lagi
  memilih kartu (kata) dari dalam rak yang sudah terpilih. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .wbs-demo {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 24px;
    cursor: pointer;
  }

  .wbs-demo__pointer {
    position: absolute;
    top: 46px;
    left: 16%;
    font-size: 22px;
    opacity: 0;
    z-index: 3;
  }

  .wbs-demo.is-in .wbs-demo__pointer {
    animation: wbs-pointer-move 1.1s ease 0.1s forwards;
  }

  @keyframes wbs-pointer-move {
    0% {
      opacity: 0;
      left: 8%;
    }
    15% {
      opacity: 1;
    }
    35% {
      left: 8%;
    }
    55% {
      left: 42%;
    }
    100% {
      left: 8%;
      opacity: 1;
    }
  }

  .wbs-demo__shelves {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .wbs-demo__shelf {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 8px 14px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--cloud);
    transition: border-color 0.35s ease, background-color 0.35s ease, transform 0.35s ease;
  }

  .wbs-demo.is-in .wbs-demo__shelf--chosen {
    animation: wbs-shelf-glow 0.5s ease 1.1s forwards;
  }

  @keyframes wbs-shelf-glow {
    to {
      border-color: var(--sunny-yellow);
      background: var(--box-main-yuk-bg);
      transform: translateY(-3px);
    }
  }

  .wbs-demo__shelf-label {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 12px;
    color: var(--slate);
  }

  .wbs-demo__cards {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 100%;
  }

  .wbs-demo__card {
    font-family: var(--font-code);
    font-size: 11px;
    text-align: center;
    padding: 3px 4px;
    border-radius: 6px;
    background: var(--white);
    border: 1px solid var(--border);
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wbs-demo.is-in .wbs-demo__card--chosen {
    animation: wbs-card-pop 0.6s ease 1.8s forwards;
  }

  @keyframes wbs-card-pop {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.25) translateY(-4px);
      background: var(--sunny-yellow);
      border-color: #f2b430;
    }
    100% {
      transform: scale(1.08) translateY(-2px);
      background: var(--pyto-green-soft);
      border-color: var(--pyto-green);
      color: var(--pyto-green-dark);
      font-weight: 700;
    }
  }

  .wbs-demo__result {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .wbs-demo__result-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    background: var(--cloud);
    border-radius: 10px;
    padding: 8px 14px;
    opacity: 0;
    transform: translateY(6px);
  }

  .wbs-demo.is-in .wbs-demo__result-box:nth-child(1) {
    animation: wbs-result-in 0.4s ease 1.4s forwards;
  }

  .wbs-demo.is-in .wbs-demo__result-box:nth-child(2) {
    animation: wbs-result-in 0.4s ease 2.3s forwards;
  }

  @keyframes wbs-result-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .wbs-demo__result-label {
    font-family: var(--font-code);
    font-size: 11px;
    font-weight: 700;
    color: var(--slate);
  }

  .wbs-demo__result-value {
    font-family: var(--font-code);
    font-weight: 800;
    font-size: 15px;
    color: var(--pyto-green-dark);
  }

  .wbs-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  .wbs-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .wbs-demo__pointer,
    .wbs-demo__shelf--chosen,
    .wbs-demo__card--chosen,
    .wbs-demo__result-box {
      animation: none !important;
    }

    .wbs-demo__pointer {
      opacity: 0;
    }

    .wbs-demo__shelf--chosen {
      border-color: var(--sunny-yellow);
      background: var(--box-main-yuk-bg);
    }

    .wbs-demo__card--chosen {
      background: var(--pyto-green-soft);
      border-color: var(--pyto-green);
      color: var(--pyto-green-dark);
      font-weight: 700;
    }

    .wbs-demo__result-box {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .wbs-demo__shelves {
      grid-template-columns: 1fr;
    }

    .wbs-demo__pointer {
      display: none;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="wbs-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
