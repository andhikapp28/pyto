---
// Animasi #5 (plan/bab-17-animasi.md) — kotak "Awas" tentang lupa
// turun_pena() lagi setelah angkat_pena(). Kartu kontras kiri/kanan. Kiri
// ("✗ Jangan begini"): Pyto-mini melayang (pena terangkat) bergerak
// membentuk pola kotak lengkap TANPA meninggalkan jejak sama sekali —
// kanvas tetap putih kosong di akhir, disertai gelembung "?! kosong banget"
// dan kaca pembesar mencari-cari jejak yang tidak ada. Kanan ("✓ Begini
// benar"): Pyto-mini yang sama, pena turun sejak awal, meninggalkan jejak
// kotak hijau yang jelas. Ilustrasi kalengan (CSS/SVG), BUKAN Pyodide
// sungguhan.
---

<div
  class="pud-demo"
  data-anim="pud-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi perbandingan kanvas kosong karena lupa turun_pena versus berhasil menggambar kotak"
>
  <div class="pud-demo__cols">
    <div class="pud-demo__col pud-demo__col--wrong">
      <span class="pud-demo__col-title">✗ lupa turun_pena()</span>
      <svg class="pud-demo__svg" viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path class="pud-demo__ghost pud-demo__ghost--1" d="M35 35 H105" />
        <path class="pud-demo__ghost pud-demo__ghost--2" d="M105 35 V105" />
        <path class="pud-demo__ghost pud-demo__ghost--3" d="M105 105 H35" />
        <path class="pud-demo__ghost pud-demo__ghost--4" d="M35 105 V35" />
      </svg>
      <span class="pud-demo__magnifier" aria-hidden="true">🔍</span>
      <span class="pud-demo__confused" aria-hidden="true">?! kosong banget</span>
    </div>

    <div class="pud-demo__col pud-demo__col--right">
      <span class="pud-demo__col-title">✓ turun_pena() lagi</span>
      <svg class="pud-demo__svg" viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path class="pud-demo__seg pud-demo__seg--1" d="M35 35 H105" />
        <path class="pud-demo__seg pud-demo__seg--2" d="M105 35 V105" />
        <path class="pud-demo__seg pud-demo__seg--3" d="M105 105 H35" />
        <path class="pud-demo__seg pud-demo__seg--4" d="M35 105 V35" />
      </svg>
      <span class="pud-demo__ok" aria-hidden="true">✅ kotak muncul</span>
    </div>
  </div>
</div>

<p class="pud-demo__hint">
  💡 Kodenya sama-sama <strong>tidak error</strong> — bedanya cuma status pena.
  <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .pud-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
  }

  .pud-demo__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .pud-demo__col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 16px 14px 20px;
  }

  .pud-demo__col--wrong {
    border: 2px solid rgba(255, 122, 107, 0.4);
  }

  .pud-demo__col--right {
    border: 2px solid rgba(47, 191, 113, 0.35);
  }

  .pud-demo__col-title {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 12px;
    color: var(--slate);
    text-align: center;
  }

  .pud-demo__svg {
    width: 130px;
    height: auto;
    background: var(--cloud);
    border-radius: 10px;
  }

  .pud-demo__col--wrong .pud-demo__svg {
    background: var(--white);
  }

  .pud-demo__ghost {
    stroke: rgba(30, 42, 50, 0.14);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 3 7;
    opacity: 0;
  }

  .pud-demo.is-in .pud-demo__ghost {
    animation: pud-ghost-move 0.4s ease forwards;
  }

  .pud-demo.is-in .pud-demo__ghost--1 {
    animation-delay: 0.2s;
  }
  .pud-demo.is-in .pud-demo__ghost--2 {
    animation-delay: 0.6s;
  }
  .pud-demo.is-in .pud-demo__ghost--3 {
    animation-delay: 1s;
  }
  .pud-demo.is-in .pud-demo__ghost--4 {
    animation-delay: 1.4s;
  }

  @keyframes pud-ghost-move {
    0%,
    30% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
    }
  }

  .pud-demo__seg {
    stroke: var(--pyto-green);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 70;
    stroke-dashoffset: 70;
  }

  .pud-demo.is-in .pud-demo__seg--1 {
    animation: pud-draw 0.4s ease 0.2s forwards;
  }
  .pud-demo.is-in .pud-demo__seg--2 {
    animation: pud-draw 0.4s ease 0.6s forwards;
  }
  .pud-demo.is-in .pud-demo__seg--3 {
    animation: pud-draw 0.4s ease 1s forwards;
  }
  .pud-demo.is-in .pud-demo__seg--4 {
    animation: pud-draw 0.4s ease 1.4s forwards;
  }

  @keyframes pud-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .pud-demo__magnifier {
    position: absolute;
    top: 34px;
    right: 22px;
    font-size: 22px;
    opacity: 0;
  }

  .pud-demo.is-in .pud-demo__magnifier {
    animation: pud-magnifier-search 1.2s ease 1.8s forwards;
  }

  @keyframes pud-magnifier-search {
    0% {
      opacity: 0;
      transform: translate(0, 0) rotate(0deg);
    }
    20% {
      opacity: 1;
    }
    50% {
      transform: translate(-14px, 6px) rotate(-8deg);
    }
    80% {
      transform: translate(10px, -8px) rotate(8deg);
    }
    100% {
      opacity: 1;
      transform: translate(0, 0) rotate(0deg);
    }
  }

  .pud-demo__confused {
    font-size: 13px;
    font-weight: 700;
    color: #c0392b;
    opacity: 0;
  }

  .pud-demo.is-in .pud-demo__confused {
    animation: pud-fade-in 0.4s ease 2.4s forwards;
  }

  .pud-demo__ok {
    font-size: 13px;
    font-weight: 700;
    color: var(--pyto-green-dark);
    opacity: 0;
  }

  .pud-demo.is-in .pud-demo__ok {
    animation: pud-fade-in 0.4s ease 1.9s forwards;
  }

  @keyframes pud-fade-in {
    to {
      opacity: 1;
    }
  }

  .pud-demo.is-in .pud-demo__col--wrong {
    animation: pud-jitter 0.5s ease 2.4s 2;
  }

  @keyframes pud-jitter {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .pud-demo__hint {
    font-size: 14px;
    color: var(--slate);
    margin: 0 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .pud-demo__ghost,
    .pud-demo__seg,
    .pud-demo__magnifier,
    .pud-demo__confused,
    .pud-demo__ok,
    .pud-demo__col--wrong {
      animation: none !important;
    }

    .pud-demo__ghost {
      opacity: 0;
    }

    .pud-demo__seg {
      stroke-dashoffset: 0;
    }

    .pud-demo__magnifier,
    .pud-demo__confused,
    .pud-demo__ok {
      opacity: 1;
    }
  }

  @media (max-width: 620px) {
    .pud-demo__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="pud-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
