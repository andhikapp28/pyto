---
// Animasi #10 — panah "Bab Selanjutnya" mengedip pelan, mengundang pembaca
// lanjut. Dipakai di akhir tiap halaman bab.
import ChapterChallenge from './ChapterChallenge.astro';
import ChapterCompleteCard from './ChapterCompleteCard.astro';
import { chapters } from '../data/chapters.js';

interface Props {
  prevHref?: string;
  prevLabel?: string;
  nextHref?: string;
  nextLabel?: string;
  nextDisabled?: boolean;
  chapterNumber?: number;
}

const {
  prevHref,
  prevLabel = '← Kembali ke Beranda',
  nextHref,
  nextLabel,
  nextDisabled = false,
  chapterNumber,
} = Astro.props;

// Deteksi otomatis nomor bab dari URL atau props untuk sinkronisasi judul dinamis
const currentPath = Astro.url.pathname;
const match = currentPath.match(/\/bab\/(\d+)\/?/);
const currentNum = chapterNumber ?? (match ? parseInt(match[1], 10) : undefined);

let resolvedPrevLabel = prevLabel;
let resolvedNextLabel = nextLabel;

if (currentNum) {
  const prevCh = chapters.find((c) => c.number === currentNum - 1);
  const nextCh = chapters.find((c) => c.number === currentNum + 1);

  if (prevCh && (!prevLabel || prevLabel.startsWith('← Bab'))) {
    resolvedPrevLabel = `← Bab ${prevCh.number}: ${prevCh.title}`;
  }
  if (nextCh && (!nextLabel || nextLabel.startsWith('Bab'))) {
    resolvedNextLabel = `Bab ${nextCh.number}: ${nextCh.title}`;
  }
}

const hasNext = Boolean(resolvedNextLabel);
---

<div class="chapter-footer-wrap">
  <ChapterChallenge chapterNumber={currentNum} />
  <ChapterCompleteCard chapterNumber={currentNum} />

  <nav class="chapter-footer-nav" data-reveal aria-label="Navigasi bab">
  {
    prevHref && (
      <a href={prevHref} class="btn btn-secondary chapter-footer-nav__prev">
        {resolvedPrevLabel}
      </a>
    )
  }

  {
    hasNext &&
      (nextDisabled ? (
        <span
          class="btn btn-primary chapter-footer-nav__next chapter-footer-nav__next--disabled"
          aria-disabled="true"
        >
          {resolvedNextLabel}
          <span class="chapter-footer-nav__arrow" aria-hidden="true">
            →
          </span>
        </span>
      ) : (
        <a href={nextHref} class="btn btn-primary chapter-footer-nav__next">
          {resolvedNextLabel}
          <span class="chapter-footer-nav__arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))
  }
</nav>
</div>

<style>
  .chapter-footer-wrap {
    width: 100%;
  }

  .chapter-footer-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .chapter-footer-nav__next--disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  .chapter-footer-nav__arrow {
    display: inline-block;
    animation: chapter-footer-nav-nudge 1.3s ease-in-out infinite;
  }

  @keyframes chapter-footer-nav-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(7px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-footer-nav__arrow {
      animation: none;
    }
  }

  @media (max-width: 600px) {
    .chapter-footer-nav {
      flex-direction: column;
      align-items: stretch;
    }

    .chapter-footer-nav .btn {
      justify-content: center;
    }
  }
</style>
