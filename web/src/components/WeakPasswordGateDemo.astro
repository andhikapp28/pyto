---
// Animasi #7 (plan/Fase2/bab-16-animasi.md) — transisi ke konsep kedua bab ini:
// pintu gerbang markas dengan panel kata sandi digital. Ketikan "123456"
// diketuk ke panel, lampu panel berkedip merah, pintu gerbang bergetar
// terbuka paksa dengan mudah — menunjukkan betapa lemahnya kata sandi umum.
const PASSWORD = '123456';
const chars = PASSWORD.split('');
---

<div
  class="wpg-demo"
  data-anim="wpg-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi pintu gerbang jebol oleh kata sandi lemah"
>
  <div class="wpg-demo__gate" id="wpg-gate">
    <span class="wpg-demo__alarm" id="wpg-alarm" aria-hidden="true">🚨</span>
    <div class="wpg-demo__door wpg-demo__door--left" id="wpg-door-left"></div>
    <div class="wpg-demo__door wpg-demo__door--right" id="wpg-door-right"></div>
    <div class="wpg-demo__panel">
      <span class="wpg-demo__light" id="wpg-light" aria-hidden="true"></span>
      <div class="wpg-demo__display" id="wpg-display">
        {
          chars.map((c, i) => (
            <span class="wpg-demo__digit" id={`wpg-digit-${i}`}>
              {c}
            </span>
          ))
        }
      </div>
    </div>
  </div>

  <p class="wpg-demo__caption" id="wpg-caption">
    Kata sandi <code>"123456"</code> — favorit para pembobol 🚨
  </p>
</div>

<p class="wpg-demo__hint">💡 <em>(Klik / hover untuk ulangi.)</em></p>

<style>
  .wpg-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    cursor: pointer;
  }

  .wpg-demo__gate {
    position: relative;
    width: 200px;
    height: 150px;
    border-radius: 12px;
    background: linear-gradient(180deg, var(--ink) 0%, #2c3a44 100%);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .wpg-demo__door {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background: linear-gradient(180deg, #445561 0%, #33424c 100%);
    border: 2px solid #1c2830;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .wpg-demo__door--left {
    left: 0;
    border-radius: 12px 0 0 12px;
    transform-origin: left center;
  }

  .wpg-demo__door--right {
    right: 0;
    border-radius: 0 12px 12px 0;
    transform-origin: right center;
  }

  .wpg-demo.is-in .wpg-demo__door--left {
    animation: wpg-open-left 0.5s ease 1.5s forwards;
  }

  .wpg-demo.is-in .wpg-demo__door--right {
    animation: wpg-open-right 0.5s ease 1.5s forwards;
  }

  @keyframes wpg-open-left {
    0%,
    30% {
      transform: rotateY(0deg);
    }
    100% {
      transform: rotateY(-55deg) translateX(-6px);
    }
  }

  @keyframes wpg-open-right {
    0%,
    30% {
      transform: rotateY(0deg);
    }
    100% {
      transform: rotateY(55deg) translateX(6px);
    }
  }

  .wpg-demo__panel {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: #1c2830;
    border-radius: 8px;
    padding: 8px 12px;
    border: 2px solid #0f171c;
  }

  .wpg-demo__light {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--slate);
  }

  .wpg-demo.is-in .wpg-demo__light {
    animation: wpg-light-red 0.4s ease 1.5s 3;
  }

  @keyframes wpg-light-red {
    0%,
    100% {
      background: var(--slate);
      box-shadow: none;
    }
    50% {
      background: var(--coral);
      box-shadow: 0 0 10px var(--coral);
    }
  }

  .wpg-demo__display {
    display: flex;
    gap: 3px;
  }

  .wpg-demo__digit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 20px;
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 13px;
    color: #4ee08a;
    opacity: 0;
  }

  .wpg-demo.is-in .wpg-demo__digit {
    animation: wpg-digit-in 0.15s ease forwards;
  }

  .wpg-demo.is-in .wpg-demo__digit:nth-child(1) {
    animation-delay: 0.2s;
  }
  .wpg-demo.is-in .wpg-demo__digit:nth-child(2) {
    animation-delay: 0.36s;
  }
  .wpg-demo.is-in .wpg-demo__digit:nth-child(3) {
    animation-delay: 0.52s;
  }
  .wpg-demo.is-in .wpg-demo__digit:nth-child(4) {
    animation-delay: 0.68s;
  }
  .wpg-demo.is-in .wpg-demo__digit:nth-child(5) {
    animation-delay: 0.84s;
  }
  .wpg-demo.is-in .wpg-demo__digit:nth-child(6) {
    animation-delay: 1s;
  }

  @keyframes wpg-digit-in {
    to {
      opacity: 1;
    }
  }

  .wpg-demo__alarm {
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 20px;
    z-index: 4;
    opacity: 0;
  }

  .wpg-demo.is-in .wpg-demo__alarm {
    animation: wpg-alarm-blink 0.4s ease 1.5s 3;
  }

  @keyframes wpg-alarm-blink {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  .wpg-demo.is-in .wpg-demo__gate {
    animation: wpg-shake 0.4s ease 1.4s;
  }

  @keyframes wpg-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-5px);
    }
    75% {
      transform: translateX(5px);
    }
  }

  .wpg-demo__caption {
    font-size: 14px;
    color: var(--slate);
    text-align: center;
  }

  .wpg-demo__caption code {
    color: #c0392b;
    font-weight: 700;
  }

  .wpg-demo__hint {
    font-size: 14px;
    color: var(--slate);
    margin: 0 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wpg-demo__door,
    .wpg-demo__light,
    .wpg-demo__digit,
    .wpg-demo__alarm,
    .wpg-demo__gate {
      animation: none !important;
    }

    .wpg-demo__digit {
      opacity: 1;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="wpg-demo"]');
  observeOnce(els, (el) => {
    el.classList.add('is-in');
  });

  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
