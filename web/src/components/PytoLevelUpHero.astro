---
// Animasi #1 (plan/bab-19-animasi.md) — hero pembuka Bab 19. Pyto muncul
// memegang kontroler game kecil, dikelilingi empat lencana konsep lama
// (dictionary Bab 11, def/fungsi Bab 12, loop Bab 7, dadu random Bab 10)
// yang melayang masuk dari empat penjuru lalu "melebur" jadi satu badge
// besar "LEVEL UP" di dada Pyto, disertai kilau singkat. Aksen --grape
// dipakai untuk badge "LEVEL UP" (lihat pemetaan token bab-19-desain.md),
// beda visual dari kaca pembesar Bab 18 dan roda alfabet Bab 16. Main
// langsung begitu halaman dibuka (tidak menunggu scroll), sama pola dengan
// hero Bab 16/17/18. Idle: badge berkilau pelan tiap beberapa detik.
import PytoMascotWave from './PytoMascotWave.astro';

const badges = [
  { icon: '🗂️', label: 'dict', corner: 'tl' },
  { icon: 'def', label: 'fungsi', corner: 'tr' },
  { icon: '🔁', label: 'loop', corner: 'bl' },
  { icon: '🎲', label: 'random', corner: 'br' },
];
---

<div class="plu" data-anim="plu">
  <div class="plu__stage">
    {
      badges.map((b) => (
        <span class={`plu__badge plu__badge--${b.corner}`} aria-hidden="true">
          <span class="plu__badge-icon">{b.icon}</span>
        </span>
      ))
    }

    <div class="plu__mascot-wrap">
      <span class="plu__controller" aria-hidden="true">🎮</span>
      <PytoMascotWave size={168} />
      <span class="plu__levelup" id="plu-levelup" aria-hidden="true">LEVEL UP!</span>
    </div>
  </div>

  <span class="plu__sr">
    Pyto memegang kontroler game kecil, dikelilingi empat lencana (dictionary, fungsi, loop,
    random) yang melayang masuk dari empat penjuru lalu melebur jadi satu badge besar "LEVEL UP" di
    dadanya.
  </span>
</div>

<style>
  .plu {
    display: flex;
    justify-content: center;
  }

  .plu__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .plu__stage {
    position: relative;
    width: 260px;
    height: 230px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .plu__mascot-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .plu__controller {
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%) rotate(-6deg) scale(0);
    font-size: 30px;
    z-index: 3;
  }

  .plu.is-in .plu__controller {
    animation: plu-controller-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.6s forwards;
  }

  @keyframes plu-controller-in {
    to {
      transform: translateX(-50%) rotate(-6deg) scale(1);
    }
  }

  .plu__levelup {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%) scale(0.5);
    background: var(--grape);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.4px;
    padding: 5px 12px;
    border-radius: 999px;
    box-shadow: 0 4px 10px rgba(139, 111, 224, 0.4);
    opacity: 0;
    z-index: 3;
  }

  .plu.is-in .plu__levelup {
    animation:
      plu-levelup-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s forwards,
      plu-levelup-idle 3s ease-in-out 2.2s infinite;
  }

  @keyframes plu-levelup-in {
    0% {
      opacity: 0;
      transform: translateX(-50%) scale(0.5);
    }
    60% {
      opacity: 1;
      transform: translateX(-50%) scale(1.25);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }

  @keyframes plu-levelup-idle {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.3);
    }
  }

  .plu__badge {
    position: absolute;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: var(--white);
    border: 2px solid var(--grape);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-soft);
    opacity: 0;
    z-index: 2;
  }

  .plu__badge-icon {
    font-size: 18px;
    font-family: var(--font-code);
    font-weight: 800;
    color: var(--grape);
  }

  .plu__badge--tl {
    top: 8px;
    left: 8px;
    transform: translate(-40px, -30px) scale(0.6);
  }

  .plu__badge--tr {
    top: 8px;
    right: 8px;
    transform: translate(40px, -30px) scale(0.6);
  }

  .plu__badge--bl {
    bottom: 24px;
    left: 8px;
    transform: translate(-40px, 30px) scale(0.6);
  }

  .plu__badge--br {
    bottom: 24px;
    right: 8px;
    transform: translate(40px, 30px) scale(0.6);
  }

  .plu.is-in .plu__badge {
    animation: plu-badge-converge 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s forwards;
  }

  .plu.is-in .plu__badge--tl {
    animation-delay: 0.1s;
  }
  .plu.is-in .plu__badge--tr {
    animation-delay: 0.25s;
  }
  .plu.is-in .plu__badge--bl {
    animation-delay: 0.4s;
  }
  .plu.is-in .plu__badge--br {
    animation-delay: 0.55s;
  }

  @keyframes plu-badge-converge {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    75% {
      opacity: 1;
      transform: translate(0, -78px) scale(0.9);
    }
    100% {
      opacity: 0;
      transform: translate(0, -78px) scale(0.4);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plu__controller,
    .plu__levelup,
    .plu__badge {
      animation: none !important;
    }

    .plu__controller {
      transform: translateX(-50%) rotate(-6deg) scale(1);
    }

    .plu__levelup {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }

    .plu__badge {
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .plu__stage {
      width: 220px;
      height: 200px;
    }
  }
</style>

<script>
  import { wireReplay } from '../scripts/reveal-anim.js';

  document.querySelectorAll('[data-anim="plu"]').forEach((el) => {
    setTimeout(() => el.classList.add('is-in'), 200);
    wireReplay(el, 'is-in');
  });
</script>
