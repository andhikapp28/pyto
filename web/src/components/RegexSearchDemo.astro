---
// Animasi #2 (plan/Fase2/bab-18-animasi.md), centerpiece pembuka — kaca pembesar
// menyisir kalimat contoh dari kiri ke kanan, berhenti begitu melewati
// deretan angka pertama (kecocokan `re.search(r"[0-9]+", kalimat)`), area
// itu menyala kuning dan badge "✅ Ditemukan!" muncul. Sekali jalan saat
// terlihat, boleh diulang lewat hover/klik/keyboard.
---

<div
  class="rsd-demo card"
  data-anim="rsd-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi re.search menemukan angka pertama dalam kalimat"
>
  <div class="rsd-demo__stage">
    <span class="rsd-demo__glass" id="rsd-glass" aria-hidden="true">🔍</span>
    <p class="rsd-demo__sentence">
      Nomor pesanan saya adalah INV-<span class="rsd-demo__match" id="rsd-match">2024-5871</span>
    </p>
    <span class="rsd-demo__badge" id="rsd-badge">✅ Ditemukan!</span>
  </div>
</div>

<p class="rsd-demo__hint">
  💡 Kaca pembesar menyisir kalimat dari kiri, berhenti begitu menemukan kecocokan pertama —
  <code>re.search()</code> tidak peduli ada berapa banyak lagi di belakangnya.
  <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .rsd-demo {
    display: flex;
    flex-direction: column;
    padding: 28px 24px 22px;
    cursor: pointer;
  }

  .rsd-demo__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-top: 24px;
  }

  .rsd-demo__glass {
    position: absolute;
    top: -6px;
    left: 4%;
    font-size: 26px;
    opacity: 0;
  }

  .rsd-demo.is-in .rsd-demo__glass {
    animation: rsd-sweep 1.6s ease 0.1s forwards;
  }

  @keyframes rsd-sweep {
    0% {
      opacity: 0;
      left: 4%;
    }
    8% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      left: 74%;
    }
  }

  .rsd-demo__sentence {
    margin: 0;
    font-family: var(--font-code);
    font-size: 16px;
    color: var(--ink);
    text-align: center;
  }

  .rsd-demo__match {
    display: inline-block;
    border-radius: 6px;
    padding: 1px 4px;
    font-weight: 700;
    background: transparent;
    transition: background-color 0.3s ease;
  }

  .rsd-demo.is-in .rsd-demo__match {
    animation: rsd-highlight 0.4s ease 1.35s forwards;
  }

  @keyframes rsd-highlight {
    to {
      background: var(--sunny-yellow);
    }
  }

  .rsd-demo__badge {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--pyto-green-dark);
    background: var(--pyto-green-soft);
    border-radius: 999px;
    padding: 6px 16px;
    opacity: 0;
    transform: scale(0.7);
  }

  .rsd-demo.is-in .rsd-demo__badge {
    animation: rsd-badge-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.7s forwards;
  }

  @keyframes rsd-badge-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .rsd-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  @media (prefers-reduced-motion: reduce) {
    .rsd-demo__glass,
    .rsd-demo__match,
    .rsd-demo__badge {
      animation: none !important;
    }

    .rsd-demo__glass {
      opacity: 1;
      left: 74%;
    }

    .rsd-demo__match {
      background: var(--sunny-yellow);
    }

    .rsd-demo__badge {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="rsd-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
