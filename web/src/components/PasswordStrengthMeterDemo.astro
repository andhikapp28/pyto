---
// Animasi #8 (plan/Fase2/bab-16-animasi.md): pintu gerbang (echo WeakPasswordGateDemo)
// muncul lagi, kali ini dengan meteran kekuatan vertikal 3 segmen di
// sampingnya. Kata sandi contoh "Rahasia9x" diketuk ke panel — tiga segmen
// menyala satu per satu sesuai aturan yang terpenuhi (panjang ≥8, ada angka,
// ada huruf besar), meteran penuh hijau, pintu gerbang tetap kokoh tertutup
// rapat (kontras dari WeakPasswordGateDemo yang jebol).
const PASSWORD = 'Rahasia9x';
const chars = PASSWORD.split('');
const segments = ['Panjang ≥ 8', 'Ada angka', 'Ada huruf besar'];
---

<div
  class="psm-demo"
  data-anim="psm-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi meteran kekuatan kata sandi Rahasia9x"
>
  <div class="psm-demo__stage">
    <div class="psm-demo__gate">
      <div class="psm-demo__door psm-demo__door--left"></div>
      <div class="psm-demo__door psm-demo__door--right"></div>
      <div class="psm-demo__panel">
        <span class="psm-demo__light" id="psm-light" aria-hidden="true"></span>
        <div class="psm-demo__display">
          {
            chars.map((c, i) => (
              <span class="psm-demo__digit" id={`psm-digit-${i}`}>
                {c}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="psm-demo__meter">
      {
        segments.map((label, i) => (
          <div class="psm-demo__segment-row">
            <span class="psm-demo__segment" id={`psm-segment-${i}`} />
            <span class="psm-demo__segment-label">{label}</span>
          </div>
        ))
      }
    </div>
  </div>

  <p class="psm-demo__caption" id="psm-caption">
    <code>"Rahasia9x"</code> → <strong>Kuat! Lumayan sulit ditebak 💪</strong>
  </p>
</div>

<p class="psm-demo__hint">💡 <em>(Klik / hover untuk ulangi.)</em></p>

<style>
  .psm-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    cursor: pointer;
  }

  .psm-demo__stage {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .psm-demo__gate {
    position: relative;
    width: 180px;
    height: 140px;
    border-radius: 12px;
    background: linear-gradient(180deg, var(--ink) 0%, #2c3a44 100%);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .psm-demo__door {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background: linear-gradient(180deg, #445561 0%, #33424c 100%);
    border: 2px solid #1c2830;
  }

  .psm-demo__door--left {
    left: 0;
    border-radius: 12px 0 0 12px;
  }

  .psm-demo__door--right {
    right: 0;
    border-radius: 0 12px 12px 0;
  }

  .psm-demo__panel {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background: #1c2830;
    border-radius: 8px;
    padding: 8px 12px;
    border: 2px solid #0f171c;
  }

  .psm-demo__light {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--slate);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .psm-demo.is-in .psm-demo__light {
    animation: psm-light-green 0.3s ease 1.9s forwards;
  }

  @keyframes psm-light-green {
    to {
      background: var(--pyto-green);
      box-shadow: 0 0 10px var(--pyto-green);
    }
  }

  .psm-demo__display {
    display: flex;
    gap: 3px;
  }

  .psm-demo__digit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 20px;
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 12px;
    color: #4ee08a;
    opacity: 0;
  }

  .psm-demo.is-in .psm-demo__digit {
    animation: psm-digit-in 0.15s ease forwards;
  }

  .psm-demo.is-in .psm-demo__digit:nth-child(1) {
    animation-delay: 0.15s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(2) {
    animation-delay: 0.3s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(3) {
    animation-delay: 0.45s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(4) {
    animation-delay: 0.6s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(5) {
    animation-delay: 0.75s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(6) {
    animation-delay: 0.9s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(7) {
    animation-delay: 1.05s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(8) {
    animation-delay: 1.2s;
  }
  .psm-demo.is-in .psm-demo__digit:nth-child(9) {
    animation-delay: 1.35s;
  }

  @keyframes psm-digit-in {
    to {
      opacity: 1;
    }
  }

  .psm-demo__meter {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .psm-demo__segment-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .psm-demo__segment {
    width: 34px;
    height: 14px;
    border-radius: 5px;
    background: var(--border);
    transition: background-color 0.3s ease;
  }

  .psm-demo__segment-label {
    font-size: 13px;
    color: var(--slate);
  }

  .psm-demo.is-in #psm-segment-0 {
    animation: psm-segment-on 0.3s ease 1.5s forwards;
  }
  .psm-demo.is-in #psm-segment-1 {
    animation: psm-segment-on 0.3s ease 1.8s forwards;
  }
  .psm-demo.is-in #psm-segment-2 {
    animation: psm-segment-on 0.3s ease 2.1s forwards;
  }

  @keyframes psm-segment-on {
    to {
      background: var(--pyto-green);
    }
  }

  .psm-demo__caption {
    font-size: 14px;
    color: var(--slate);
    text-align: center;
    opacity: 0;
  }

  .psm-demo.is-in .psm-demo__caption {
    animation: psm-fade-in 0.4s ease 2.4s forwards;
  }

  @keyframes psm-fade-in {
    to {
      opacity: 1;
    }
  }

  .psm-demo__caption code {
    color: var(--grape);
    font-weight: 700;
  }

  .psm-demo__caption strong {
    color: var(--pyto-green-dark);
  }

  .psm-demo__hint {
    font-size: 14px;
    color: var(--slate);
    margin: 0 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .psm-demo__light,
    .psm-demo__digit,
    .psm-demo__segment,
    .psm-demo__caption {
      animation: none !important;
      opacity: 1;
    }

    .psm-demo__segment {
      background: var(--pyto-green);
    }

    .psm-demo__light {
      background: var(--pyto-green);
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="psm-demo"]');
  observeOnce(els, (el) => {
    el.classList.add('is-in');
  });

  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
