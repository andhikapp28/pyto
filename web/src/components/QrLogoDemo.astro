---
// Animasi #7 (plan/bab-14-animasi.md, kotak "Tahu Lebih"): pola QR biasa
// tampil, sebuah lapisan cahaya tipis "memperkuat" seluruh pola (visualisasi
// error_correction tinggi), lalu logo kecil melayang turun & "menempel" di
// tengah. Sesaat kemudian ikon HP memindai kode yang sudah ada logonya dan
// tetap berhasil (✅) — membuktikan tetap terbaca meski ditutupi logo.
// Sekali jalan saat terlihat, boleh diulang lewat hover/klik/fokus.
---

<div
  class="qld-demo"
  data-anim="qld-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi menempel logo di tengah kode QR"
>
  <div class="qld-demo__code">
    <div class="qld-demo__line">
      <span class="tok-var">qr</span> = qrcode.<span class="tok-fn">QRCode</span>(error_correction=ERROR_CORRECT_H, ...)
    </div>
    <div class="qld-demo__line">
      kode_qr.<span class="qld-demo__glow tok-fn">paste</span>(logo_kecil, (posisi_x, posisi_y))
    </div>
  </div>

  <div class="qld-demo__stage">
    <div class="qld-demo__qr" aria-hidden="true">
      {Array.from({ length: 49 }).map((_, i) => <span class="qld-demo__cell" style={`--d:${i}`} />)}
      <span class="qld-demo__glow-ring" aria-hidden="true"></span>
      <span class="qld-demo__logo" aria-hidden="true">🐍</span>
    </div>
    <span class="qld-demo__arrow" aria-hidden="true">📡</span>
    <span class="qld-demo__check" aria-hidden="true">✅</span>
  </div>
</div>

<p class="qld-demo__hint">
  💡 <code>error_correction=ERROR_CORRECT_H</code> membuat kode QR tahan sampai ~30% areanya
  tertutup — cukup aman untuk ditempeli logo kecil. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .qld-demo {
    display: flex;
    flex-direction: column;
    gap: 18px;
    cursor: pointer;
  }

  .qld-demo__code {
    background: var(--code-bg);
    border-radius: var(--radius-code);
    padding: 14px 16px;
    font-family: var(--font-code);
    font-size: 12px;
    line-height: 1.8;
    color: var(--code-text);
    overflow-x: auto;
  }

  .qld-demo__line {
    white-space: pre;
  }

  .tok-var {
    color: var(--code-red);
  }

  .tok-fn {
    color: var(--code-blue);
  }

  .qld-demo__glow {
    border-radius: 4px;
  }

  .qld-demo.is-in .qld-demo__glow {
    animation: qld-demo-code-glow 0.6s ease 1.8s;
  }

  @keyframes qld-demo-code-glow {
    0%,
    100% {
      background: transparent;
    }
    40% {
      background: rgba(97, 175, 239, 0.28);
    }
  }

  .qld-demo__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .qld-demo__qr {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    width: 90px;
    height: 90px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px;
  }

  .qld-demo__cell {
    background: var(--ink);
    opacity: var(--cell-opacity, 1);
    border-radius: 1px;
  }

  .qld-demo__cell:nth-child(4n) {
    --cell-opacity: 0;
  }

  .qld-demo__cell:nth-child(9n + 2) {
    --cell-opacity: 0;
  }

  .qld-demo__glow-ring {
    position: absolute;
    inset: -4px;
    border-radius: 10px;
    border: 2px solid var(--sky-blue);
    opacity: 0;
  }

  .qld-demo.is-in .qld-demo__glow-ring {
    animation: qld-demo-ring-pulse 0.6s ease 0.3s;
  }

  @keyframes qld-demo-ring-pulse {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  .qld-demo__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -140%) scale(0.6);
    font-size: 22px;
    opacity: 0;
    background: #fff;
    border-radius: 50%;
    line-height: 1;
    padding: 3px;
  }

  .qld-demo.is-in .qld-demo__logo {
    animation: qld-demo-logo-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards;
  }

  @keyframes qld-demo-logo-in {
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .qld-demo__arrow {
    font-size: 20px;
    opacity: 0;
  }

  .qld-demo.is-in .qld-demo__arrow {
    animation: qld-demo-fade-in 0.3s ease 1.7s forwards;
  }

  .qld-demo__check {
    font-size: 22px;
    opacity: 0;
    transform: scale(0.6);
  }

  .qld-demo.is-in .qld-demo__check {
    animation: qld-demo-check-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 2.2s forwards;
  }

  @keyframes qld-demo-fade-in {
    to {
      opacity: 1;
    }
  }

  @keyframes qld-demo-check-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .qld-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--ink);
  }

  .qld-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .qld-demo__glow,
    .qld-demo__glow-ring,
    .qld-demo__logo,
    .qld-demo__arrow,
    .qld-demo__check {
      animation: none !important;
    }

    .qld-demo__glow-ring {
      opacity: 0;
    }

    .qld-demo__logo,
    .qld-demo__arrow,
    .qld-demo__check {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="qld-demo"]');

  observeOnce(els, (el) => {
    el.classList.add('is-in');
  });

  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
