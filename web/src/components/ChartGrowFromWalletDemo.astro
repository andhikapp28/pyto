---
// Animasi #7 (plan/Fase2/bab-20-animasi.md), Centerpiece 2 — PALING PENTING
// SELURUH BAB, pertama kali matplotlib "muncul" secara konseptual di buku
// ini. Kartu ringkasan (echo akhir FullRecordingLoopDemo, dompet dengan
// amplop berisi total) di kiri, panah menunjukkan tiap amplop "berubah
// wujud" jadi satu batang grafik di kanan -- tinggi tiap batang tumbuh dari
// 0 naik ke nilai akhirnya, semua diwarnai hijau Pyto (--pyto-green, persis
// `color="#2FBF71"` yang dipakai literal di kode Python). Judul dan label
// sumbu X/Y muncul terakhir dengan fade-in. Lencana kecil
// "✨ Pertama kali di buku ini!" muncul sekilas. Sekali jalan saat terlihat,
// boleh diulang lewat hover/klik/keyboard.
const categories = [
  { label: 'jajan', value: 3000, heightPct: 100 },
  { label: 'transportasi', value: 1500, heightPct: 50 },
];
---

<div
  class="cgw-demo card"
  data-anim="cgw-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi amplop berubah jadi grafik batang"
>
  <span class="cgw-demo__first-badge" id="cgw-first-badge">✨ Pertama kali di buku ini!</span>

  <div class="cgw-demo__stage">
    <div class="cgw-demo__wallet">
      <span class="cgw-demo__wallet-title">Ringkasan</span>
      {
        categories.map((c) => (
          <span class="cgw-demo__envelope">
            ✉️ {c.label}: Rp{c.value.toLocaleString('id-ID')}
          </span>
        ))
      }
    </div>

    <span class="cgw-demo__arrow" aria-hidden="true">➡️</span>

    <div class="cgw-demo__chart">
      <span class="cgw-demo__chart-title" id="cgw-chart-title">Grafik Pengeluaran</span>
      <div class="cgw-demo__bars">
        {
          categories.map((c, i) => (
            <div class="cgw-demo__bar-col">
              <span class="cgw-demo__bar-value" id={`cgw-bar-value-${i}`}>
                Rp{c.value.toLocaleString('id-ID')}
              </span>
              <span
                class="cgw-demo__bar"
                id={`cgw-bar-${i}`}
                style={`--cgw-h:${c.heightPct}%`}
              />
              <span class="cgw-demo__bar-label" id={`cgw-bar-label-${i}`}>
                {c.label}
              </span>
            </div>
          ))
        }
      </div>
      <span class="cgw-demo__axis-label" id="cgw-ylabel">Jumlah (Rp)</span>
    </div>
  </div>
</div>

<p class="cgw-demo__hint">
  💡 <code>plt.bar(nama_kategori, total_kategori, color="#2FBF71")</code> menggambar satu batang per
  kategori — data yang sama persis dengan yang sudah kamu catat lewat dictionary.
  <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .cgw-demo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 26px 20px;
    cursor: pointer;
  }

  .cgw-demo__first-badge {
    position: absolute;
    top: 10px;
    right: 14px;
    font-size: 11px;
    font-weight: 800;
    color: var(--pyto-green-dark);
    background: var(--pyto-green-soft);
    border: 1px solid var(--pyto-green);
    border-radius: 999px;
    padding: 4px 10px;
    opacity: 0;
    transform: scale(0.8);
  }

  .cgw-demo.is-in .cgw-demo__first-badge {
    animation: cgw-badge-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1.8s forwards;
  }

  @keyframes cgw-badge-pop {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    60% {
      opacity: 1;
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .cgw-demo__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    width: 100%;
  }

  .cgw-demo__wallet {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    background: var(--cloud);
    border: 2px dashed var(--border);
    border-radius: 12px;
    padding: 12px 16px;
    min-width: 170px;
  }

  .cgw-demo__wallet-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    color: var(--slate);
  }

  .cgw-demo__envelope {
    font-size: 12px;
    font-weight: 700;
    color: var(--pyto-green-dark);
    background: var(--pyto-green-soft);
    border-radius: 999px;
    padding: 4px 10px;
  }

  .cgw-demo__arrow {
    font-size: 22px;
    opacity: 0.7;
  }

  .cgw-demo__chart {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 16px 22px 10px;
    min-width: 190px;
  }

  .cgw-demo__chart-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
    opacity: 0;
  }

  .cgw-demo.is-in .cgw-demo__chart-title {
    animation: cgw-fade-in 0.4s ease 1.7s forwards;
  }

  @keyframes cgw-fade-in {
    to {
      opacity: 1;
    }
  }

  .cgw-demo__bars {
    display: flex;
    align-items: flex-end;
    gap: 18px;
    height: 90px;
  }

  .cgw-demo__bar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    height: 100%;
    justify-content: flex-end;
  }

  .cgw-demo__bar-value {
    font-family: var(--font-code);
    font-size: 10px;
    font-weight: 700;
    color: var(--slate);
    opacity: 0;
  }

  .cgw-demo.is-in .cgw-demo__bar-value {
    animation: cgw-fade-in 0.3s ease forwards;
  }

  .cgw-demo.is-in #cgw-bar-value-0 {
    animation-delay: 1s;
  }

  .cgw-demo.is-in #cgw-bar-value-1 {
    animation-delay: 1.4s;
  }

  .cgw-demo__bar {
    display: block;
    width: 34px;
    height: 0;
    background: var(--pyto-green);
    border-radius: 4px 4px 0 0;
  }

  .cgw-demo.is-in #cgw-bar-0 {
    animation: cgw-grow-0 0.5s ease 0.7s forwards;
  }

  .cgw-demo.is-in #cgw-bar-1 {
    animation: cgw-grow-1 0.5s ease 1.1s forwards;
  }

  @keyframes cgw-grow-0 {
    to {
      height: var(--cgw-h);
    }
  }

  @keyframes cgw-grow-1 {
    to {
      height: var(--cgw-h);
    }
  }

  .cgw-demo__bar-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--slate);
    opacity: 0;
  }

  .cgw-demo.is-in .cgw-demo__bar-label {
    animation: cgw-fade-in 0.3s ease forwards;
  }

  .cgw-demo.is-in #cgw-bar-label-0 {
    animation-delay: 1.1s;
  }

  .cgw-demo.is-in #cgw-bar-label-1 {
    animation-delay: 1.5s;
  }

  .cgw-demo__axis-label {
    font-size: 10px;
    font-weight: 700;
    color: var(--slate);
    opacity: 0;
  }

  .cgw-demo.is-in .cgw-demo__axis-label {
    animation: cgw-fade-in 0.4s ease 1.7s forwards;
  }

  .cgw-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  .cgw-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .cgw-demo__first-badge,
    .cgw-demo__chart-title,
    .cgw-demo__bar-value,
    .cgw-demo__bar,
    .cgw-demo__bar-label,
    .cgw-demo__axis-label {
      animation: none !important;
    }

    .cgw-demo__first-badge,
    .cgw-demo__chart-title,
    .cgw-demo__bar-value,
    .cgw-demo__bar-label,
    .cgw-demo__axis-label {
      opacity: 1;
    }

    .cgw-demo__bar {
      height: var(--cgw-h);
    }
  }

  @media (max-width: 560px) {
    .cgw-demo__stage {
      flex-direction: column;
    }

    .cgw-demo__arrow {
      transform: rotate(90deg);
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="cgw-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
