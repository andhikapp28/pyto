---
// Animasi #9 (plan/bab-19-animasi.md) — kotak "Tahu Lebih" hitung_nyawa_awal().
// Dua kata berdampingan: "duku" (pendek, 4 huruf → 5 nyawa) dan "indonesia"
// (panjang, 9 huruf → 7 nyawa). Masing-masing "diukur" oleh penggaris kecil
// (aksen netral --slate), lalu menghasilkan baris hati (--coral, warna hati
// bukan status error) — dua hati "bonus" pada kata panjang muncul dengan
// efek pop tambahan menandakan nyawa ekstra. Sekali jalan saat terlihat,
// boleh diulang lewat hover/klik/keyboard.
const words = [
  { text: 'duku', lives: 5, bonus: 0 },
  { text: 'indonesia', lives: 7, bonus: 2 },
];
---

<div
  class="dsd-demo"
  data-anim="dsd-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi jatah nyawa menyesuaikan panjang kata"
>
  <div class="dsd-demo__cols">
    {
      words.map((w, wi) => (
        <div class={`dsd-demo__col dsd-demo__col--${wi}`}>
          <span class="dsd-demo__word">"{w.text}"</span>
          <div class="dsd-demo__ruler-wrap">
            <span class="dsd-demo__ruler-fill" style={`--dsd-len:${w.text.length}`} />
            <span class="dsd-demo__ruler-label">{w.text.length} huruf</span>
          </div>
          <div class="dsd-demo__hearts">
            {
              Array.from({ length: w.lives }).map((_, hi) => (
                <span
                  class:list={[
                    'dsd-demo__heart',
                    { 'dsd-demo__heart--bonus': hi >= w.lives - w.bonus },
                  ]}
                  style={`--dsd-heart-i:${hi}`}
                >
                  ❤️
                </span>
              ))
            }
          </div>
          <span class="dsd-demo__caption">{w.lives} nyawa{w.bonus > 0 ? ` (+${w.bonus} bonus)` : ''}</span>
        </div>
      ))
    }
  </div>
</div>

<p class="dsd-demo__hint">
  💡 <code>hitung_nyawa_awal(kata)</code> memakai <code>len()</code> untuk memberi jatah nyawa lebih
  besar ke kata yang lebih panjang. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .dsd-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 22px 24px;
    cursor: pointer;
  }

  .dsd-demo__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .dsd-demo__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: var(--cloud);
    border-radius: 12px;
    padding: 14px 10px;
  }

  .dsd-demo__word {
    font-family: var(--font-code);
    font-weight: 800;
    font-size: 15px;
    color: var(--ink);
  }

  .dsd-demo__ruler-wrap {
    position: relative;
    width: 100%;
    height: 8px;
    background: repeating-linear-gradient(
      90deg,
      var(--border),
      var(--border) 1px,
      transparent 1px,
      transparent 8px
    );
    border-radius: 4px;
    overflow: visible;
  }

  .dsd-demo__ruler-fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--slate);
    border-radius: 4px;
    transition: none;
  }

  .dsd-demo.is-in .dsd-demo__col--0 .dsd-demo__ruler-fill {
    animation: dsd-ruler-grow-0 0.7s ease 0.2s forwards;
  }

  .dsd-demo.is-in .dsd-demo__col--1 .dsd-demo__ruler-fill {
    animation: dsd-ruler-grow-1 0.7s ease 0.4s forwards;
  }

  @keyframes dsd-ruler-grow-0 {
    to {
      width: 44%;
    }
  }

  @keyframes dsd-ruler-grow-1 {
    to {
      width: 100%;
    }
  }

  .dsd-demo__ruler-label {
    display: block;
    margin-top: 6px;
    font-size: 11px;
    font-weight: 700;
    color: var(--slate);
    text-align: center;
    opacity: 0;
  }

  .dsd-demo.is-in .dsd-demo__col--0 .dsd-demo__ruler-label {
    animation: dsd-fade-in 0.3s ease 0.9s forwards;
  }

  .dsd-demo.is-in .dsd-demo__col--1 .dsd-demo__ruler-label {
    animation: dsd-fade-in 0.3s ease 1.1s forwards;
  }

  @keyframes dsd-fade-in {
    to {
      opacity: 1;
    }
  }

  .dsd-demo__hearts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 3px;
    max-width: 130px;
    margin-top: 4px;
  }

  .dsd-demo__heart {
    font-size: 15px;
    opacity: 0;
    transform: scale(0.5);
  }

  .dsd-demo.is-in .dsd-demo__col--0 .dsd-demo__heart {
    animation: dsd-heart-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(1.2s + var(--dsd-heart-i) * 0.08s);
  }

  .dsd-demo.is-in .dsd-demo__col--1 .dsd-demo__heart {
    animation: dsd-heart-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(1.4s + var(--dsd-heart-i) * 0.08s);
  }

  .dsd-demo.is-in .dsd-demo__heart--bonus {
    animation-name: dsd-heart-pop-bonus;
  }

  @keyframes dsd-heart-pop {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes dsd-heart-pop-bonus {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }
    60% {
      opacity: 1;
      transform: scale(1.5);
    }
    100% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .dsd-demo__caption {
    font-size: 12px;
    font-weight: 700;
    color: var(--coral);
    opacity: 0;
  }

  .dsd-demo.is-in .dsd-demo__col--0 .dsd-demo__caption {
    animation: dsd-fade-in 0.3s ease 1.8s forwards;
  }

  .dsd-demo.is-in .dsd-demo__col--1 .dsd-demo__caption {
    animation: dsd-fade-in 0.3s ease 2.2s forwards;
  }

  .dsd-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  .dsd-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .dsd-demo__ruler-fill,
    .dsd-demo__ruler-label,
    .dsd-demo__heart,
    .dsd-demo__caption {
      animation: none !important;
    }

    .dsd-demo__col--0 .dsd-demo__ruler-fill {
      width: 44%;
    }

    .dsd-demo__col--1 .dsd-demo__ruler-fill {
      width: 100%;
    }

    .dsd-demo__ruler-label,
    .dsd-demo__heart,
    .dsd-demo__caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .dsd-demo__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="dsd-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
