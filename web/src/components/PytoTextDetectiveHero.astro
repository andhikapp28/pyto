---
// Animasi #1 (plan/bab-18-animasi.md): Pyto memakai topi detektif kecil dan
// memegang kaca pembesar, berdiri di depan selembar dokumen penuh teks acak.
// Kaca pembesarnya menyisir baris-baris dokumen dan menyorot (highlight
// kuning) sebuah alamat email lalu sebuah nomor telepon yang tersembunyi di
// antara teks lain, satu per satu, lalu Pyto berkedip puas ke pembaca. Main
// langsung begitu halaman dibuka (tidak menunggu scroll), sama pola dengan
// hero Bab 16/17. Idle: kaca pembesar berkilau pelan tiap beberapa detik.
// NB: bukan `PytoDetectiveHero.astro` — nama itu sudah dipakai Bab 9 (hero
// error handling yang tidak berhubungan), jadi komponen ini sengaja diberi
// nama beda supaya tidak bentrok.
import PytoMascotWave from './PytoMascotWave.astro';
---

<div class="ptdh" data-anim="ptdh">
  <div class="ptdh__document" aria-hidden="true">
    <span class="ptdh__line ptdh__line--full"></span>
    <span class="ptdh__line ptdh__line--short"></span>
    <span class="ptdh__token ptdh__token--email" id="ptdh-email">budi@email.com</span>
    <span class="ptdh__line ptdh__line--full"></span>
    <span class="ptdh__token ptdh__token--phone" id="ptdh-phone">0812-3456-7890</span>
    <span class="ptdh__line ptdh__line--short"></span>
    <span class="ptdh__glass" id="ptdh-glass">🔍</span>
  </div>

  <div class="ptdh__mascot-wrap">
    <span class="ptdh__hat" aria-hidden="true">🎩</span>
    <PytoMascotWave size={140} />
  </div>

  <span class="ptdh__sr">
    Pyto memakai topi detektif dan memegang kaca pembesar di depan selembar dokumen penuh teks.
    Kaca pembesarnya menyisir teks dan menyorot sebuah alamat email dan sebuah nomor telepon yang
    tersembunyi, satu per satu, lalu Pyto mengedip puas.
  </span>
</div>

<style>
  .ptdh {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .ptdh__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .ptdh__document {
    position: relative;
    width: 216px;
    background: var(--white);
    border: 3px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-soft);
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ptdh__line {
    display: block;
    height: 9px;
    border-radius: 4px;
    background: var(--cloud);
  }

  .ptdh__line--full {
    width: 100%;
  }

  .ptdh__line--short {
    width: 62%;
  }

  .ptdh__token {
    display: inline-block;
    width: fit-content;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--cloud);
    color: var(--slate);
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 11px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .ptdh.is-in .ptdh__token--email {
    animation: ptdh-highlight 0.5s ease 1.1s forwards;
  }

  .ptdh.is-in .ptdh__token--phone {
    animation: ptdh-highlight 0.5s ease 1.9s forwards;
  }

  @keyframes ptdh-highlight {
    to {
      background: var(--sunny-yellow);
      color: var(--ink);
    }
  }

  .ptdh__glass {
    position: absolute;
    left: 16px;
    top: 12px;
    font-size: 26px;
    opacity: 0;
  }

  .ptdh.is-in .ptdh__glass {
    animation:
      ptdh-glass-sweep 2.3s ease 0.15s forwards,
      ptdh-glass-idle 3.2s ease-in-out 2.6s infinite;
  }

  @keyframes ptdh-glass-sweep {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    6% {
      opacity: 1;
    }
    45% {
      transform: translateY(60px);
    }
    80% {
      transform: translateY(102px);
    }
    100% {
      opacity: 1;
      transform: translateY(102px);
    }
  }

  @keyframes ptdh-glass-idle {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.35);
    }
  }

  .ptdh__mascot-wrap {
    position: relative;
    opacity: 0;
    transform: translateX(14px);
  }

  .ptdh.is-in .ptdh__mascot-wrap {
    animation: ptdh-mascot-in 0.7s ease 2.1s forwards;
  }

  @keyframes ptdh-mascot-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ptdh__hat {
    position: absolute;
    top: -16px;
    left: 50%;
    transform: translateX(-50%) rotate(-6deg) scale(0.85);
    font-size: 28px;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .ptdh__token--email,
    .ptdh__token--phone,
    .ptdh__glass,
    .ptdh__mascot-wrap {
      animation: none !important;
    }

    .ptdh__token--email,
    .ptdh__token--phone {
      background: var(--sunny-yellow);
      color: var(--ink);
    }

    .ptdh__glass {
      opacity: 1;
      transform: translateY(102px);
    }

    .ptdh__mascot-wrap {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .ptdh {
      gap: 16px;
    }

    .ptdh__document {
      width: 180px;
    }
  }
</style>

<script>
  import { wireReplay } from '../scripts/reveal-anim.js';

  // Hero selalu terlihat begitu halaman dibuka (tidak perlu menunggu scroll),
  // sama pola dengan PytoSecretAgentHero.astro/PytoArtistHero.astro.
  document.querySelectorAll('[data-anim="ptdh"]').forEach((el) => {
    setTimeout(() => el.classList.add('is-in'), 200);
    wireReplay(el, 'is-in');
  });
</script>
