---
// Animasi #6 (plan/bab-19-animasi.md), Centerpiece 1c — BEAT TERPENTING
// BAB INI. Simulasi siklus penuh loop utama Tebak Kata: papan huruf (echo
// GuessBoard.astro / beat #3), baris hati berkurang, berujung menang.
// Kata contoh "jerapah" (7 huruf, ada di kategori_kata["hewan"]).
// Rangkaian ditampilkan lewat JS (setTimeout) mengikuti pola
// WordGuessCaseSensitivityAwas.astro (Bab 19) yang juga mengoreografikan animasi
// bertahap lewat JS, bukan murni CSS keyframe lintas-komponen. Sekali
// jalan saat terlihat, boleh diulang lewat hover/klik/keyboard.
import GuessBoard from './GuessBoard.astro';

const word = 'jerapah';
const TOTAL_LIVES = 5;

// Rangkaian tebakan simulasi (huruf, benar/salah/berulang) — echo naskah
// Kotak Inti #1 (lanjutan): if tebakan in tebakan_benar / elif tebakan in
// kata_rahasia / else sisa_nyawa -= 1.
const steps = [
  { letter: 'r', kind: 'correct', indexes: [2] },
  { letter: 'z', kind: 'wrong' },
  { letter: 'r', kind: 'repeat' },
  { letter: 'a', kind: 'correct', indexes: [3, 5] },
  { letter: '', kind: 'complete', indexes: [0, 1, 4, 6] },
];
---

<div
  class="mgl-demo card"
  data-anim="mgl-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi simulasi loop utama tebak kata sampai menang"
>
  <div class="mgl-demo__hearts" id="mgl-hearts">
    {
      Array.from({ length: TOTAL_LIVES }).map((_, i) => (
        <span class="mgl-demo__heart" id={`mgl-heart-${i}`}>
          <span class="mgl-demo__heart-full" aria-hidden="true">❤️</span>
          <span class="mgl-demo__heart-broken" aria-hidden="true">💔</span>
        </span>
      ))
    }
  </div>

  <GuessBoard idPrefix="mgl" word={word} />

  <div class="mgl-demo__inputbox">
    <span class="mgl-demo__input-label">Tebak satu huruf:</span>
    <span class="mgl-demo__input-field" id="mgl-input-field">&nbsp;</span>
  </div>

  <div class="mgl-demo__log" id="mgl-log" aria-live="polite"></div>

  <div class="mgl-demo__banner" id="mgl-banner">🎉 Menang! Kata rahasianya "jerapah"</div>
</div>

<p class="mgl-demo__hint">
  💡 Loop terus berjalan selama nyawa masih ada DAN belum menang — huruf benar membuka kotak, huruf
  salah mengurangi nyawa, huruf yang sudah pernah ditebak tidak mengubah apa pun.
  <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .mgl-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 24px;
    cursor: pointer;
  }

  .mgl-demo__hearts {
    display: flex;
    gap: 4px;
    font-size: 20px;
  }

  .mgl-demo__heart {
    position: relative;
    width: 22px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mgl-demo__heart-full,
  .mgl-demo__heart-broken {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .mgl-demo__heart-broken {
    opacity: 0;
  }

  .mgl-demo__heart.is-broken .mgl-demo__heart-full {
    opacity: 0;
  }

  .mgl-demo__heart.is-broken .mgl-demo__heart-broken {
    opacity: 1;
  }

  .mgl-demo__heart.is-shaking {
    animation: mgl-heart-shake 0.4s ease;
  }

  @keyframes mgl-heart-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px) rotate(-8deg);
    }
    75% {
      transform: translateX(4px) rotate(8deg);
    }
  }

  .mgl-demo__inputbox {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--cloud);
    border-radius: 10px;
    padding: 6px 12px;
    font-size: 13px;
  }

  .mgl-demo__input-label {
    color: var(--slate);
    font-weight: 700;
  }

  .mgl-demo__input-field {
    min-width: 28px;
    text-align: center;
    font-family: var(--font-code);
    font-weight: 800;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 8px;
    color: var(--pyto-green-dark);
  }

  .mgl-demo__log {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-height: 26px;
    width: 100%;
    max-width: 320px;
  }

  .mgl-demo__log :global(.mgl-demo__log-row) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--slate);
    background: var(--cloud);
    border-radius: 8px;
    padding: 4px 10px;
    opacity: 0;
    transform: translateY(4px);
    animation: mgl-log-in 0.3s ease forwards;
  }

  @keyframes mgl-log-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .mgl-demo__log :global(.mgl-demo__log-row--correct) {
    color: var(--pyto-green-dark);
    background: var(--pyto-green-soft);
  }

  .mgl-demo__log :global(.mgl-demo__log-row--wrong) {
    color: #c0392b;
    background: var(--box-awas-bg);
  }

  .mgl-demo__banner {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 16px;
    color: var(--pyto-green-dark);
    text-align: center;
    opacity: 0;
    transform: scale(0.85);
  }

  .mgl-demo__banner.is-shown {
    animation: mgl-banner-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes mgl-banner-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .mgl-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  @media (prefers-reduced-motion: reduce) {
    .mgl-demo__heart.is-shaking {
      animation: none !important;
    }

    .mgl-demo__log :global(.mgl-demo__log-row) {
      animation: none !important;
      opacity: 1;
      transform: none;
    }

    .mgl-demo__banner.is-shown {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const TOTAL_LIVES = 5;
  const STEP_MS = 650;
  const START_MS = 350;

  const steps = [
    { letter: 'r', kind: 'correct', indexes: [2] },
    { letter: 'z', kind: 'wrong' },
    { letter: 'r', kind: 'repeat' },
    { letter: 'a', kind: 'correct', indexes: [3, 5] },
    { letter: '', kind: 'complete', indexes: [0, 1, 4, 6] },
  ];

  function addLogRow(el: Element, text: string, variant: string) {
    const log = el.querySelector('#mgl-log');
    if (!log) return;
    const row = document.createElement('div');
    row.className = `mgl-demo__log-row${variant ? ` mgl-demo__log-row--${variant}` : ''}`;
    row.textContent = text;
    log.appendChild(row);
    // batasi maksimal 4 baris kelihatan supaya kartu tidak melar
    while (log.children.length > 4) {
      log.removeChild(log.firstChild as ChildNode);
    }
  }

  function reset(el: Element) {
    for (let i = 0; i < 7; i += 1) {
      document.getElementById(`mgl-box-${i}`)?.classList.remove(
        'guess-board__box--open',
        'guess-board__box--flash',
        'guess-board__box--win'
      );
    }
    for (let i = 0; i < TOTAL_LIVES; i += 1) {
      const heart = document.getElementById(`mgl-heart-${i}`);
      heart?.classList.remove('is-broken', 'is-shaking');
    }
    const log = el.querySelector('#mgl-log');
    if (log) log.innerHTML = '';
    const input = el.querySelector('#mgl-input-field');
    if (input) input.textContent = ' ';
    const banner = el.querySelector('#mgl-banner');
    banner?.classList.remove('is-shown');
    const board = document.getElementById('mgl-board');
    board?.classList.remove('guess-board--faded');
  }

  function play(el: Element) {
    reset(el);
    let livesLost = 0;

    steps.forEach((step, i) => {
      const delay = START_MS + i * STEP_MS;

      setTimeout(() => {
        const input = el.querySelector('#mgl-input-field');
        if (input && step.letter) input.textContent = step.letter;

        if (step.kind === 'correct') {
          step.indexes?.forEach((idx) => {
            document
              .getElementById(`mgl-box-${idx}`)
              ?.classList.add('guess-board__box--open', 'guess-board__box--flash');
          });
          addLogRow(el, `Tebak "${step.letter}" → Benar!`, 'correct');
        } else if (step.kind === 'wrong') {
          livesLost += 1;
          const heartIdx = TOTAL_LIVES - livesLost;
          const heart = document.getElementById(`mgl-heart-${heartIdx}`);
          heart?.classList.add('is-broken', 'is-shaking');
          addLogRow(el, `Tebak "${step.letter}" → Salah! Sisa nyawa: ${TOTAL_LIVES - livesLost}`, 'wrong');
        } else if (step.kind === 'repeat') {
          addLogRow(el, `Tebak "${step.letter}" → 🔁 sudah pernah ditebak`, '');
        } else if (step.kind === 'complete') {
          step.indexes?.forEach((idx) => {
            document
              .getElementById(`mgl-box-${idx}`)
              ?.classList.add('guess-board__box--open', 'guess-board__box--flash');
          });
          setTimeout(() => {
            for (let b = 0; b < 7; b += 1) {
              document.getElementById(`mgl-box-${b}`)?.classList.add('guess-board__box--win');
            }
            addLogRow(el, '🎉 Selamat! Kata rahasianya "jerapah".', 'correct');
            el.querySelector('#mgl-banner')?.classList.add('is-shown');
          }, 300);
        }
      }, delay);
    });
  }

  const els = document.querySelectorAll('[data-anim="mgl-demo"]');
  observeOnce(els, (el) => {
    el.classList.add('is-in');
    play(el);
  });
  els.forEach((el) => {
    wireReplay(el, 'is-in');
    el.addEventListener('mouseenter', () => play(el));
    el.addEventListener('click', () => play(el));
  });
</script>
