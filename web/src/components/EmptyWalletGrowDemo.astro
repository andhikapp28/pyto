---
// Animasi #2 (plan/Fase2/bab-20-animasi.md), Centerpiece 1a — dompet kosong yang
// tumbuh. Sebuah dompet kecil BENAR-BENAR KOSONG (beda dari Bab 11 yang
// selalu mulai terisi) muncul, laci "jajan" geser masuk berisi Rp5.000, lalu
// koin +3.000 melayang masuk ke laci yang SAMA dan angkanya "menghitung
// naik" dari 5.000 ke 8.000. Echo naskah Langkah 1 Kotak Inti #1. Sekali
// jalan saat terlihat, boleh diulang lewat hover/klik/keyboard.
---

<div
  class="ewg-demo card"
  data-anim="ewg-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi dompet kosong yang tumbuh berisi kategori jajan"
>
  <div class="ewg-demo__wallet" id="ewg-wallet">
    <span class="ewg-demo__wallet-label">kategori_pengeluaran</span>
    <div class="ewg-demo__slot" id="ewg-empty-note">
      <span>kosong — <code>{'{}'}</code></span>
    </div>
    <div class="ewg-demo__drawer" id="ewg-drawer">
      <span class="ewg-demo__drawer-label">"jajan"</span>
      <span class="ewg-demo__drawer-amount" id="ewg-amount">Rp5.000</span>
    </div>
  </div>
  <span class="ewg-demo__coin" id="ewg-coin" aria-hidden="true">🪙 +3.000</span>
</div>

<p class="ewg-demo__hint">
  💡 <code>kategori_pengeluaran = {'{}'}</code> boleh mulai benar-benar kosong — laci baru dibuat
  otomatis begitu kategorinya pertama kali muncul. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .ewg-demo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 24px;
    cursor: pointer;
    min-height: 150px;
    justify-content: center;
  }

  .ewg-demo__wallet {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: var(--cloud);
    border: 2px dashed var(--border);
    border-radius: 14px;
    padding: 16px 24px;
    min-width: 200px;
  }

  .ewg-demo__wallet-label {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 12px;
    color: var(--slate);
  }

  .ewg-demo__slot {
    font-size: 13px;
    color: var(--slate);
  }

  .ewg-demo__slot code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  .ewg-demo.is-in .ewg-demo__slot {
    animation: ewg-fade-out 0.3s ease 0.9s forwards;
  }

  @keyframes ewg-fade-out {
    to {
      opacity: 0;
      height: 0;
      margin: 0;
    }
  }

  .ewg-demo__drawer {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--pyto-green-soft);
    border: 2px solid var(--pyto-green);
    border-radius: 10px;
    padding: 8px 16px;
    opacity: 0;
    transform: translateX(-24px);
  }

  .ewg-demo.is-in .ewg-demo__drawer {
    animation: ewg-drawer-in 0.4s ease 1.1s forwards;
  }

  @keyframes ewg-drawer-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ewg-demo__drawer-label {
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pyto-green-dark);
    font-size: 14px;
  }

  .ewg-demo__drawer-amount {
    font-family: var(--font-code);
    font-weight: 800;
    color: var(--ink);
    font-size: 14px;
  }

  .ewg-demo__coin {
    font-size: 14px;
    font-weight: 700;
    color: var(--sunny-yellow);
    background: var(--white);
    border-radius: 999px;
    padding: 4px 12px;
    box-shadow: var(--shadow-soft);
    opacity: 0;
    position: relative;
    top: -6px;
  }

  .ewg-demo.is-in .ewg-demo__coin {
    animation: ewg-coin-in 0.6s ease 1.7s forwards;
  }

  @keyframes ewg-coin-in {
    0% {
      opacity: 0;
      transform: translateY(10px) scale(0.7);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-14px) scale(0.9);
    }
  }

  .ewg-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  .ewg-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .ewg-demo__slot,
    .ewg-demo__drawer,
    .ewg-demo__coin {
      animation: none !important;
    }

    .ewg-demo__slot {
      opacity: 0;
      height: 0;
    }

    .ewg-demo__drawer {
      opacity: 1;
      transform: none;
    }

    .ewg-demo__coin {
      opacity: 0;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  function animateCount(el: HTMLElement | null, from: number, to: number, delayMs: number, durationMs: number) {
    if (!el) return;
    setTimeout(() => {
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / durationMs);
        const value = Math.round(from + (to - from) * t);
        el.textContent = `Rp${value.toLocaleString('id-ID')}`;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, delayMs);
  }

  function play(el: Element) {
    const amountEl = el.querySelector('#ewg-amount') as HTMLElement | null;
    if (amountEl) amountEl.textContent = 'Rp5.000';
    animateCount(amountEl, 5000, 8000, 2100, 500);
  }

  const els = document.querySelectorAll('[data-anim="ewg-demo"]');
  observeOnce(els, (el) => {
    el.classList.add('is-in');
    play(el);
  });
  els.forEach((el) => {
    wireReplay(el, 'is-in');
    el.addEventListener('mouseenter', () => play(el));
    el.addEventListener('click', () => play(el));
  });
</script>
