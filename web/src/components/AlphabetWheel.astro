---
// Roda alfabet dasar dipakai ulang oleh 5 demo Bab 16 (lihat
// plan/design/bab-16-desain.md): OrdChrWheelDemo, CaesarShiftDemo,
// CaesarShiftReverseDemo, CaseSensitiveAwas, BruteForceDemo. Satu komponen
// ilustrasi murni (posisi geometri dihitung sekali di frontmatter), semua
// animasi/interaksi didorong lewat elemen ber-id unik (idPrefix) yang
// dimanipulasi langsung oleh <script> tiap komponen pemanggil — jadi tidak
// perlu CSS ":global" lintas komponen, cukup document.getElementById biasa.
//
// 26 huruf tersusun keliling seperti jam, mulai dari atas (A) searah jarum
// jam. `needleIndex` menaruh jarum kecil menunjuk satu huruf. `showRing`
// menambahkan cincin luar putar (aksen --grape) yang bisa diputar lewat JS
// pemanggil dengan mengganti `style.transform` elemen ber-id
// `${idPrefix}-ring` (selalu set ulang lengkap: "translate(-50%,-50%)
// rotate(NNdeg)").
interface Props {
  idPrefix: string;
  size?: number;
  needleIndex?: number | null;
  showRing?: boolean;
  ringRotationDeg?: number;
  label?: string;
}

const {
  idPrefix,
  size = 200,
  needleIndex = null,
  showRing = false,
  ringRotationDeg = 0,
  label,
} = Astro.props;

const N = 26;
const letters = Array.from({ length: N }, (_, i) => String.fromCharCode(65 + i));
const center = size / 2;
const radius = size / 2 - 16;

const positions = letters.map((_, i) => {
  const angle = (360 / N) * i - 90;
  const rad = (angle * Math.PI) / 180;
  return {
    x: center + radius * Math.cos(rad),
    y: center + radius * Math.sin(rad),
    angle,
  };
});

const needleAngle = needleIndex != null ? positions[needleIndex].angle + 90 : 0;
const ringSize = size + 26;
---

<div class="aw-wheel" id={`${idPrefix}-wheel`} style={`--aw-size:${size}px;`}>
  <div class="aw-wheel__dial" style={`width:${size}px;height:${size}px;`}>
    {
      letters.map((l, i) => (
        <span
          class="aw-wheel__letter"
          id={`${idPrefix}-letter-${i}`}
          data-index={i}
          style={`left:${positions[i].x}px;top:${positions[i].y}px;`}
        >
          {l}
        </span>
      ))
    }
    <div class="aw-wheel__hub" aria-hidden="true"></div>
    <div
      class="aw-wheel__needle"
      id={`${idPrefix}-needle`}
      style={`transform: translate(-50%, -100%) rotate(${needleAngle}deg); opacity: ${
        needleIndex != null ? 1 : 0
      };`}
      aria-hidden="true"
    >
    </div>
  </div>

  {
    showRing && (
      <div
        class="aw-wheel__ring"
        id={`${idPrefix}-ring`}
        style={`width:${ringSize}px;height:${ringSize}px;transform:translate(-50%,-50%) rotate(${ringRotationDeg}deg);`}
        aria-hidden="true"
      >
        <span class="aw-wheel__ring-arrow">▲</span>
      </div>
    )
  }

  {label && <span class="aw-wheel__label">{label}</span>}
</div>

<style>
  .aw-wheel {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .aw-wheel__dial {
    position: relative;
    border-radius: 999px;
    background: var(--white);
    border: 3px solid var(--border);
    box-shadow: var(--shadow-soft);
  }

  .aw-wheel__letter {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 12px;
    color: var(--slate);
    border-radius: 999px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .aw-wheel__letter.is-active {
    color: #fff;
    background: var(--pyto-green);
    transform: translate(-50%, -50%) scale(1.3);
    z-index: 2;
  }

  .aw-wheel__letter.is-target {
    color: #fff;
    background: var(--grape);
    transform: translate(-50%, -50%) scale(1.3);
    z-index: 2;
  }

  .aw-wheel__letter.is-dim {
    opacity: 0.35;
  }

  .aw-wheel__hub {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--ink);
    transform: translate(-50%, -50%);
  }

  .aw-wheel__needle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3px;
    height: calc(var(--aw-size) / 2 - 8px);
    background: linear-gradient(var(--grape), var(--ink));
    border-radius: 2px;
    transform-origin: bottom center;
    transition:
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.3s ease;
  }

  .aw-wheel__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 999px;
    border: 4px dashed var(--grape);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  .aw-wheel__ring-arrow {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--grape);
    font-size: 14px;
    line-height: 1;
  }

  .aw-wheel__label {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 12px;
    color: var(--slate);
  }

  @media (prefers-reduced-motion: reduce) {
    .aw-wheel__letter,
    .aw-wheel__needle,
    .aw-wheel__ring {
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .aw-wheel__letter {
      width: 18px;
      height: 18px;
      font-size: 10px;
    }
  }
</style>
