---
// Animasi #4 (plan/bab-14-animasi.md): pola QR baru (isi alamat website)
// tampil, lalu sebuah ikon HP memindainya — begitu berhasil, layar HP
// menampilkan mini jendela browser dengan logo Python meluncur masuk,
// seolah tautannya benar-benar terbuka. Sekali jalan saat terlihat, boleh
// diulang lewat hover/klik/fokus.
---

<div
  class="qwl-demo"
  data-anim="qwl-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi kode QR alamat website dipindai lalu membuka tautan"
>
  <div class="qwl-demo__code">
    <div class="qwl-demo__line">
      <span class="tok-var">alamat_website</span> = <span class="tok-str">&quot;https://www.python.org&quot;</span>
    </div>
    <div class="qwl-demo__line">
      <span class="tok-var">kode_qr</span> = qrcode.<span class="tok-fn">make</span>(alamat_website)
    </div>
  </div>

  <div class="qwl-demo__stage">
    <div class="qwl-demo__qr" aria-hidden="true">
      {Array.from({ length: 36 }).map((_, i) => <span class="qwl-demo__cell" style={`--d:${i}`} />)}
    </div>
    <span class="qwl-demo__arrow" aria-hidden="true">📡</span>
    <div class="qwl-demo__phone" aria-hidden="true">
      <span class="qwl-demo__browser">
        <span class="qwl-demo__dot"></span>
        <span class="qwl-demo__python">🐍 python.org</span>
      </span>
    </div>
  </div>
</div>

<p class="qwl-demo__hint">
  💡 Kamera HP yang mengenali isinya sebagai alamat web biasanya langsung menawarkan "buka tautan".
  <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .qwl-demo {
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 22px 24px;
    cursor: pointer;
  }

  .qwl-demo__code {
    background: var(--code-bg);
    border-radius: var(--radius-code);
    padding: 16px 18px;
    font-family: var(--font-code);
    font-size: 13px;
    line-height: 1.85;
    color: var(--code-text);
    overflow-x: auto;
  }

  .qwl-demo__line {
    white-space: pre;
  }

  .tok-var {
    color: var(--code-red);
  }

  .tok-fn {
    color: var(--code-blue);
  }

  .tok-str {
    color: var(--code-green);
  }

  .qwl-demo__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .qwl-demo__qr {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3px;
    width: 84px;
    height: 84px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 5px;
  }

  .qwl-demo__cell {
    background: var(--ink);
    opacity: var(--cell-opacity, 1);
    border-radius: 1px;
  }

  .qwl-demo__cell:nth-child(4n) {
    --cell-opacity: 0;
  }

  .qwl-demo__cell:nth-child(7n + 3) {
    --cell-opacity: 0;
  }

  .qwl-demo__arrow {
    font-size: 20px;
    opacity: 0;
    transform: scale(0.7);
  }

  .qwl-demo.is-in .qwl-demo__arrow {
    animation: qwl-demo-pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s forwards;
  }

  @keyframes qwl-demo-pop-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .qwl-demo__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 96px;
    border: 3px solid var(--ink);
    border-radius: 14px;
    background: var(--white);
    overflow: hidden;
  }

  .qwl-demo__browser {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: translateY(12px);
  }

  .qwl-demo.is-in .qwl-demo__browser {
    animation: qwl-demo-browser-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.9s forwards;
  }

  @keyframes qwl-demo-browser-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .qwl-demo__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pyto-green);
  }

  .qwl-demo__python {
    font-family: var(--font-code);
    font-size: 10px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  .qwl-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  @media (prefers-reduced-motion: reduce) {
    .qwl-demo__arrow,
    .qwl-demo__browser {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .qwl-demo__code {
      font-size: 12px;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="qwl-demo"]');

  observeOnce(els, (el) => {
    el.classList.add('is-in');
  });

  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
