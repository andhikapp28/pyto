---
// Animasi #1 (plan/bab-16-animasi.md): Pyto memakai kacamata hitam kecil
// dan topi fedora mini, memegang koper kunci kombinasi. Sepucuk surat biasa
// ("AGEN RAHASIA") melayang masuk dari kiri, lalu Pyto "mengetuk" surat itu
// dengan ekornya — hurufnya berputar seperti roda sandi dan berubah jadi
// pesan tersandi acak ("DJHQ UDKDVLD"). Pyto mengedipkan mata ke pembaca
// lewat kacamatanya. Main langsung begitu halaman terbuka. Idle: kacamata
// Pyto berkedip pantulan cahaya pelan tiap beberapa detik.
import PytoMascotWave from './PytoMascotWave.astro';
---

<div class="shero" data-anim="shero">
  <div class="shero__letter" aria-hidden="true">
    <span class="shero__letter-face shero__letter-face--plain">AGEN RAHASIA</span>
    <span class="shero__letter-face shero__letter-face--coded">DJHQ UDKDVLD</span>
  </div>

  <div class="shero__mascot-wrap">
    <span class="shero__hat" aria-hidden="true">🎩</span>
    <PytoMascotWave size={148} />
    <span class="shero__glasses" aria-hidden="true">🕶️</span>
    <span class="shero__case" aria-hidden="true">💼</span>
  </div>

  <span class="shero__sr">
    Pyto memakai kacamata hitam dan topi fedora, memegang koper. Sepucuk surat bertuliskan "AGEN
    RAHASIA" melayang masuk, lalu berputar dan berubah jadi pesan tersandi "DJHQ UDKDVLD".
  </span>
</div>

<style>
  .shero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .shero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .shero__letter {
    position: relative;
    width: 168px;
    height: 46px;
    opacity: 0;
    transform: translateX(-40px);
  }

  .shero.is-in .shero__letter {
    animation: shero-letter-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s forwards;
  }

  @keyframes shero-letter-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .shero__letter-face {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.5px;
    background: var(--white);
    border: 2px solid var(--border);
    box-shadow: var(--shadow-soft);
    backface-visibility: hidden;
  }

  .shero__letter-face--plain {
    color: var(--ink);
  }

  .shero__letter-face--coded {
    color: #fff;
    background: var(--grape);
    border-color: var(--grape);
    transform: rotateY(180deg);
  }

  .shero.is-in .shero__letter-face--plain {
    animation: shero-flip-out 0.7s ease 1s forwards;
  }

  .shero.is-in .shero__letter-face--coded {
    animation: shero-flip-in 0.7s ease 1s forwards;
  }

  @keyframes shero-flip-out {
    0% {
      transform: rotateY(0deg);
    }
    100% {
      transform: rotateY(180deg);
    }
  }

  @keyframes shero-flip-in {
    0% {
      transform: rotateY(180deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  .shero__mascot-wrap {
    position: relative;
  }

  .shero__hat {
    position: absolute;
    top: -18px;
    left: 50%;
    transform: translateX(-50%) rotate(-8deg) scale(0.8);
    font-size: 30px;
    z-index: 2;
  }

  .shero__glasses {
    position: absolute;
    top: 46px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 24px;
    z-index: 2;
  }

  .shero.is-in .shero__glasses {
    animation: shero-wink 3.6s ease-in-out 1.9s infinite;
  }

  @keyframes shero-wink {
    0%,
    88%,
    100% {
      transform: translateX(-50%) scaleY(1);
    }
    94% {
      transform: translateX(-50%) scaleY(0.15);
    }
  }

  .shero__case {
    position: absolute;
    bottom: 4px;
    right: -14px;
    font-size: 26px;
    opacity: 0;
    transform: translateY(10px) scale(0.7);
  }

  .shero.is-in .shero__case {
    animation: shero-case-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s forwards;
  }

  @keyframes shero-case-in {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shero__letter,
    .shero__letter-face--plain,
    .shero__letter-face--coded,
    .shero__glasses,
    .shero__case {
      animation: none !important;
    }

    .shero__letter {
      opacity: 1;
      transform: none;
    }

    .shero__letter-face--coded {
      transform: rotateY(180deg);
    }

    .shero__case {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .shero {
      gap: 16px;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-anim="shero"]').forEach((el) => {
    setTimeout(() => el.classList.add('is-in'), 200);
  });
</script>
