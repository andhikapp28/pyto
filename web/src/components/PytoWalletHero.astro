---
// Animasi #1 (plan/Fase2/bab-20-animasi.md) — hero pembuka Bab 20. Pyto memegang
// dompet digital kecil; dompet terbuka dan dari dalamnya melayang keluar dua
// koin (uang masuk/keluar) dan satu ikon "{}" (dictionary) yang memudar,
// lalu di detik terakhir sebuah grafik batang mini tumbuh dari dasar dompet
// dan "membeku" jadi ikon kecil melayang di atas kepala Pyto (idle: berkedip
// pelan). Pola strukturnya mengikuti PytoLevelUpHero.astro (Bab 19) --
// badge/ikon melayang di sekitar maskot -- tapi arah gerak dibalik (item
// KELUAR dari dompet, bukan MASUK ke badge). Aksen --grape untuk detail
// dekoratif dompet (lihat pemetaan token bab-20-desain.md), beda visual dari
// badge "LEVEL UP" Bab 19. Main langsung begitu halaman dibuka.
import PytoMascotWave from './PytoMascotWave.astro';
---

<div class="pwh" data-anim="pwh">
  <div class="pwh__stage">
    <span class="pwh__coin pwh__coin--1" aria-hidden="true">🪙</span>
    <span class="pwh__coin pwh__coin--2" aria-hidden="true">🪙</span>
    <span class="pwh__dict" aria-hidden="true">{ }</span>

    <div class="pwh__mascot-wrap">
      <span class="pwh__wallet" aria-hidden="true">👛</span>
      <PytoMascotWave size={168} />
      <span class="pwh__chart" id="pwh-chart" aria-hidden="true">📊</span>
    </div>
  </div>

  <span class="pwh__sr">
    Pyto membuka dompet digital kecil — dari dalamnya melayang keluar dua koin dan ikon dictionary
    kosong, lalu sebuah grafik batang mini tumbuh dan membeku jadi ikon melayang di atas kepala
    Pyto.
  </span>
</div>

<style>
  .pwh {
    display: flex;
    justify-content: center;
  }

  .pwh__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .pwh__stage {
    position: relative;
    width: 260px;
    height: 230px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pwh__mascot-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pwh__wallet {
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%) scale(0.85);
    font-size: 30px;
    z-index: 3;
  }

  .pwh.is-in .pwh__wallet {
    animation: pwh-wallet-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
  }

  @keyframes pwh-wallet-pop {
    0% {
      transform: translateX(-50%) scale(0.6);
    }
    60% {
      transform: translateX(-50%) scale(1.05);
    }
    100% {
      transform: translateX(-50%) scale(0.85);
    }
  }

  .pwh__coin,
  .pwh__dict {
    position: absolute;
    left: 50%;
    bottom: 10px;
    font-size: 20px;
    opacity: 0;
    z-index: 2;
  }

  .pwh__dict {
    font-family: var(--font-code);
    font-weight: 800;
    color: var(--grape);
    font-size: 17px;
  }

  .pwh.is-in .pwh__coin--1 {
    animation: pwh-float-out-left 1s ease 0.5s forwards;
  }

  .pwh.is-in .pwh__coin--2 {
    animation: pwh-float-out-right 1s ease 0.7s forwards;
  }

  .pwh.is-in .pwh__dict {
    animation: pwh-float-out-up 1s ease 0.9s forwards;
  }

  @keyframes pwh-float-out-left {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) scale(0.6);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-140%, -90px) scale(1);
    }
  }

  @keyframes pwh-float-out-right {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) scale(0.6);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(40%, -100px) scale(1);
    }
  }

  @keyframes pwh-float-out-up {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) scale(0.6);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -70px) scale(1.1);
    }
  }

  .pwh__chart {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%) scale(0.5);
    font-size: 22px;
    opacity: 0;
    z-index: 3;
  }

  .pwh.is-in .pwh__chart {
    animation:
      pwh-chart-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s forwards,
      pwh-chart-idle 3s ease-in-out 2.2s infinite;
  }

  @keyframes pwh-chart-in {
    0% {
      opacity: 0;
      transform: translateX(-50%) scale(0.5);
    }
    60% {
      opacity: 1;
      transform: translateX(-50%) scale(1.25);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }

  @keyframes pwh-chart-idle {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pwh__wallet,
    .pwh__coin,
    .pwh__dict,
    .pwh__chart {
      animation: none !important;
    }

    .pwh__wallet {
      transform: translateX(-50%) scale(0.85);
    }

    .pwh__coin,
    .pwh__dict {
      opacity: 0;
    }

    .pwh__chart {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }

  @media (max-width: 560px) {
    .pwh__stage {
      width: 220px;
      height: 200px;
    }
  }
</style>

<script>
  import { wireReplay } from '../scripts/reveal-anim.js';

  document.querySelectorAll('[data-anim="pwh"]').forEach((el) => {
    setTimeout(() => el.classList.add('is-in'), 200);
    wireReplay(el, 'is-in');
  });
</script>
