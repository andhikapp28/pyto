---
// Animasi #9 (plan/Fase2/bab-17-animasi.md) — kotak "Tahu Lebih": dua mini kanvas
// berdampingan. Kiri: segilima beraturan tertutup rapi dengan sudut 72°
// (garis-garisnya TIDAK saling menyilang). Kanan: bintang (echo beat #4,
// sudut 144°) dengan garis-garis yang jelas saling menyilang. Anak panah
// kecil menghubungkan keduanya dengan label "72° × 2 = 144°" yang muncul di
// tengah. Ilustrasi kalengan (CSS/SVG), BUKAN Pyodide sungguhan.
---

<div
  class="sam-demo"
  data-anim="sam-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi perbandingan segilima beraturan 72 derajat dengan bintang 144 derajat"
>
  <div class="sam-demo__cols">
    <div class="sam-demo__col">
      <span class="sam-demo__col-title">belok_kanan(72) — segilima</span>
      <svg class="sam-demo__svg" viewBox="0 0 180 168" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          class="sam-demo__path sam-demo__path--pentagon"
          d="M90 25 L151.8 69.9 L128.2 142.6 L51.8 142.6 L28.2 69.9 Z"
        />
      </svg>
    </div>

    <div class="sam-demo__arrow-wrap" aria-hidden="true">
      <span class="sam-demo__arrow">→</span>
      <span class="sam-demo__label">72° × 2 = 144°</span>
    </div>

    <div class="sam-demo__col">
      <span class="sam-demo__col-title">belok_kanan(144) — bintang</span>
      <svg class="sam-demo__svg" viewBox="0 0 180 168" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          class="sam-demo__path sam-demo__path--star"
          d="M90 25 L128.2 142.6 L28.2 69.9 L151.8 69.9 L51.8 142.6 Z"
        />
      </svg>
    </div>
  </div>
</div>

<p class="sam-demo__hint">
  💡 Segilima berputar total <strong>360°</strong> (satu putaran), bintang berputar total
  <strong>720°</strong> (dua putaran) karena garisnya melompati satu titik — itu sebabnya
  sudutnya dua kali lipat. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .sam-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
  }

  .sam-demo__cols {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .sam-demo__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 14px;
  }

  .sam-demo__col-title {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 11px;
    color: var(--slate);
    text-align: center;
  }

  .sam-demo__svg {
    width: 130px;
    height: auto;
    background: var(--cloud);
    border-radius: 10px;
  }

  .sam-demo__path {
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    stroke-dasharray: 460;
    stroke-dashoffset: 460;
  }

  .sam-demo__path--pentagon {
    stroke: var(--sky-blue);
  }

  .sam-demo__path--star {
    stroke: var(--sunny-yellow);
  }

  .sam-demo.is-in .sam-demo__path--pentagon {
    animation: sam-draw 1s ease 0.2s forwards;
  }

  .sam-demo.is-in .sam-demo__path--star {
    animation: sam-draw 1s ease 1.3s forwards;
  }

  @keyframes sam-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .sam-demo__arrow-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    opacity: 0;
    transform: translateY(-6px);
  }

  .sam-demo.is-in .sam-demo__arrow-wrap {
    animation: sam-label-in 0.5s ease 2.3s forwards;
  }

  @keyframes sam-label-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .sam-demo__arrow {
    font-size: 22px;
    color: var(--slate);
  }

  .sam-demo__label {
    font-family: var(--font-code);
    font-weight: 800;
    font-size: 13px;
    color: var(--grape);
    background: rgba(139, 111, 224, 0.12);
    border-radius: 999px;
    padding: 4px 12px;
    white-space: nowrap;
  }

  .sam-demo__hint {
    font-size: 14px;
    color: var(--slate);
    margin: 0 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sam-demo__path,
    .sam-demo__arrow-wrap {
      animation: none !important;
      stroke-dashoffset: 0;
    }

    .sam-demo__arrow-wrap {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 620px) {
    .sam-demo__cols {
      flex-direction: column;
    }

    .sam-demo__arrow-wrap {
      transform: rotate(90deg) translateY(0);
    }

    .sam-demo.is-in .sam-demo__arrow-wrap {
      animation: sam-label-in-mobile 0.5s ease 2.3s forwards;
    }

    @keyframes sam-label-in-mobile {
      to {
        opacity: 1;
      }
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="sam-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
