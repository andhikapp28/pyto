---
// Animasi #5 (plan/Fase2/bab-20-animasi.md) — kotak "Awas" KeyError amplop yang
// belum ada. Kontras dua kolom: "✗ Jangan begini" (koin dijatuhkan ke amplop
// "jajan" yang TIDAK ADA — mental/terpental + getar + ❌ + label
// `💥 KeyError: 'jajan'`), "✓ Begini benar" (koin melewati mesin kecil
// `.get(kategori, 0)` yang otomatis membuat amplop baru berisi 0 sebelum
// koin masuk — mulus + ✅). Pola dua kolom mengikuti
// WordGuessCaseSensitivityAwas.astro (Bab 19). Tepi/getar --coral untuk versi
// salah, tepi --pyto-green untuk versi benar, aksen mesin --grape. Sekali
// jalan saat terlihat, boleh diulang lewat hover/klik/keyboard.
---

<div
  class="kea-demo"
  data-anim="kea-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi kontras KeyError tanpa get vs dengan get"
>
  <div class="kea-demo__cols">
    <div class="kea-demo__col kea-demo__col--wrong">
      <span class="kea-demo__title">✗ Tanpa <code>.get()</code></span>
      <div class="kea-demo__row">
        <span class="kea-demo__coin kea-demo__coin--drop" id="kea-coin-wrong">🪙</span>
        <span class="kea-demo__envelope kea-demo__envelope--missing" id="kea-envelope-wrong">
          ✉️ jajan?
        </span>
      </div>
      <span class="kea-demo__result kea-demo__result--wrong" id="kea-result-wrong">
        💥 KeyError: 'jajan'
      </span>
    </div>

    <div class="kea-demo__col kea-demo__col--right">
      <span class="kea-demo__title">✓ Dengan <code>.get()</code></span>
      <div class="kea-demo__row">
        <span class="kea-demo__coin kea-demo__coin--in" id="kea-coin-in">🪙</span>
        <span class="kea-demo__machine" id="kea-machine">.get(kategori, 0)</span>
        <span class="kea-demo__envelope kea-demo__envelope--made" id="kea-envelope-right">
          ✉️ jajan: 0
        </span>
      </div>
      <span class="kea-demo__result kea-demo__result--right" id="kea-result-right">✅ Aman!</span>
    </div>
  </div>
</div>

<p class="kea-demo__hint">
  💡 <code>kategori_pengeluaran[kategori] += jumlah</code> tetap harus MEMBACA laci lama dulu — kalau
  belum ada, <code>KeyError</code>. <code>.get(kategori, 0)</code> memberi cadangan <code>0</code>
  supaya laci baru langsung terbuat. <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .kea-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
  }

  .kea-demo__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .kea-demo__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 18px 14px;
  }

  .kea-demo__col--wrong {
    border: 2px solid rgba(255, 122, 107, 0.4);
  }

  .kea-demo__col--right {
    border: 2px solid rgba(47, 191, 113, 0.35);
  }

  .kea-demo__title {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 12px;
    color: var(--slate);
    text-align: center;
  }

  .kea-demo__title code {
    color: var(--grape);
  }

  .kea-demo__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
  }

  .kea-demo__coin {
    font-size: 20px;
  }

  .kea-demo__coin--drop {
    opacity: 0;
    transform: translateY(-14px);
  }

  .kea-demo.is-in .kea-demo__coin--drop {
    animation: kea-drop-in 0.4s ease 0.2s forwards, kea-drop-reject 0.5s ease 0.7s forwards;
  }

  @keyframes kea-drop-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes kea-drop-reject {
    0% {
      transform: translateY(0);
    }
    20% {
      transform: translateX(-6px);
    }
    40% {
      transform: translateX(6px);
    }
    60% {
      transform: translateX(-4px);
    }
    80% {
      transform: translateX(10px) translateY(-2px);
    }
    100% {
      transform: translateX(16px) translateY(-6px) rotate(20deg);
    }
  }

  .kea-demo__envelope {
    font-size: 12px;
    font-weight: 700;
    border-radius: 999px;
    padding: 5px 11px;
  }

  .kea-demo__envelope--missing {
    color: var(--slate);
    border: 1px dashed var(--border);
  }

  .kea-demo.is-in .kea-demo__envelope--missing {
    animation: kea-shake 0.4s ease 1.1s 2;
  }

  @keyframes kea-shake {
    0%,
    100% {
      transform: translateX(0);
      border-color: var(--border);
    }
    25% {
      transform: translateX(-3px);
      border-color: var(--coral);
    }
    75% {
      transform: translateX(3px);
      border-color: var(--coral);
    }
  }

  .kea-demo__result {
    font-size: 12px;
    font-weight: 700;
    opacity: 0;
  }

  .kea-demo.is-in .kea-demo__result--wrong {
    animation: kea-result-in 0.3s ease 1.5s forwards;
    color: #c0392b;
  }

  @keyframes kea-result-in {
    to {
      opacity: 1;
    }
  }

  /* --- kolom kanan (benar) --- */
  .kea-demo__machine {
    font-family: var(--font-code);
    font-weight: 800;
    font-size: 10px;
    color: #fff;
    background: var(--grape);
    border-radius: 999px;
    padding: 4px 9px;
    opacity: 0;
    transform: scale(0.7);
  }

  .kea-demo.is-in .kea-demo__machine {
    animation: kea-machine-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 1s forwards;
  }

  @keyframes kea-machine-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .kea-demo__coin--in {
    opacity: 0;
    transform: translateY(-14px);
  }

  .kea-demo.is-in .kea-demo__coin--in {
    animation: kea-drop-in 0.4s ease 0.2s forwards, kea-fade-out 0.2s ease 1s forwards;
  }

  @keyframes kea-fade-out {
    to {
      opacity: 0;
    }
  }

  .kea-demo__envelope--made {
    color: var(--slate);
    border: 1px dashed var(--border);
    opacity: 0.5;
  }

  .kea-demo.is-in .kea-demo__envelope--made {
    animation: kea-envelope-made 0.4s ease 1.3s forwards;
  }

  @keyframes kea-envelope-made {
    to {
      opacity: 1;
      color: var(--pyto-green-dark);
      background: var(--pyto-green-soft);
      border: 1px solid var(--pyto-green);
    }
  }

  .kea-demo.is-in .kea-demo__result--right {
    animation: kea-result-in 0.3s ease 1.9s forwards;
    color: var(--pyto-green-dark);
  }

  .kea-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
  }

  .kea-demo__hint code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .kea-demo__coin--drop,
    .kea-demo__coin--in,
    .kea-demo__envelope--missing,
    .kea-demo__envelope--made,
    .kea-demo__machine,
    .kea-demo__result {
      animation: none !important;
    }

    .kea-demo__coin--drop {
      opacity: 1;
      transform: translateX(16px) translateY(-6px) rotate(20deg);
    }

    .kea-demo__coin--in {
      opacity: 0;
    }

    .kea-demo__envelope--made {
      opacity: 1;
      color: var(--pyto-green-dark);
      background: var(--pyto-green-soft);
      border: 1px solid var(--pyto-green);
    }

    .kea-demo__machine {
      opacity: 1;
      transform: scale(1);
    }

    .kea-demo__result {
      opacity: 1;
    }
  }

  @media (max-width: 560px) {
    .kea-demo__cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="kea-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
