---
// Animasi #4 (plan/bab-17-animasi.md), Centerpiece 2 — konsep terpenting bab
// ini: loop `for _ in range(5): maju(100); belok_kanan(144)` yang sudah
// dikuasai pembaca sejak Bab 7 (dulu cuma mengulang print()) sekarang
// mengulang GERAKAN dan membentuk bintang bersudut lima. Sebuah badge kecil
// `for _ in range(5):` "berdenyut" tiap kali satu iterasi selesai, sinkron
// dengan satu segmen garis bintang yang muncul. Di iterasi kelima, garis
// terakhir "mengunci" balik ke titik awal dengan kilatan bintang kecil ✨
// sebagai penanda bentuknya sudah lengkap. Ilustrasi kalengan (CSS/SVG),
// BUKAN Pyodide sungguhan — hanya "Coba Sendiri" yang Python sungguhan.
---

<div
  class="sld-demo"
  data-anim="sld-demo"
  tabindex="0"
  role="button"
  aria-label="Ulangi animasi loop menggambar bintang bersudut lima"
>
  <span class="sld-demo__badge" aria-hidden="true">for _ in range(5):</span>

  <svg class="sld-demo__svg" viewBox="0 0 180 168" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path class="sld-demo__seg sld-demo__seg--1" d="M90 25 L128.2 142.6" />
    <path class="sld-demo__seg sld-demo__seg--2" d="M128.2 142.6 L28.2 69.9" />
    <path class="sld-demo__seg sld-demo__seg--3" d="M28.2 69.9 L151.8 69.9" />
    <path class="sld-demo__seg sld-demo__seg--4" d="M151.8 69.9 L51.8 142.6" />
    <path class="sld-demo__seg sld-demo__seg--5" d="M51.8 142.6 L90 25" />
    <text class="sld-demo__sparkle" x="90" y="20" text-anchor="middle">✨</text>
  </svg>
</div>

<p class="sld-demo__hint">
  💡 Ulangi <strong>5</strong> kali, belok <strong>144°</strong> tiap putaran — garisnya melompati
  satu titik dan menyilang, membentuk bintang, bukan segilima biasa.
  <em>(Klik / hover untuk ulangi.)</em>
</p>

<style>
  .sld-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 22px 24px;
    cursor: pointer;
  }

  .sld-demo__badge {
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 13px;
    color: var(--pyto-green-dark);
    background: var(--pyto-green-soft);
    border-radius: 999px;
    padding: 6px 14px;
    transform: scale(1);
  }

  .sld-demo.is-in .sld-demo__badge {
    animation: sld-badge-pulse 0.45s ease 0.05s 5;
  }

  @keyframes sld-badge-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.12);
    }
  }

  .sld-demo__svg {
    width: 200px;
    height: auto;
    background: var(--cloud);
    border-radius: 10px;
  }

  .sld-demo__seg {
    stroke: var(--sunny-yellow);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 140;
    stroke-dashoffset: 140;
  }

  .sld-demo.is-in .sld-demo__seg--1 {
    animation: sld-draw 0.45s ease 0s forwards;
  }
  .sld-demo.is-in .sld-demo__seg--2 {
    animation: sld-draw 0.45s ease 0.45s forwards;
  }
  .sld-demo.is-in .sld-demo__seg--3 {
    animation: sld-draw 0.45s ease 0.9s forwards;
  }
  .sld-demo.is-in .sld-demo__seg--4 {
    animation: sld-draw 0.45s ease 1.35s forwards;
  }
  .sld-demo.is-in .sld-demo__seg--5 {
    animation: sld-draw 0.45s ease 1.8s forwards;
  }

  @keyframes sld-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .sld-demo__sparkle {
    font-size: 22px;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.4);
  }

  .sld-demo.is-in .sld-demo__sparkle {
    animation: sld-sparkle-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 2.25s forwards;
  }

  @keyframes sld-sparkle-pop {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    60% {
      opacity: 1;
      transform: scale(1.3);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .sld-demo__hint {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 2px;
    color: var(--slate);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .sld-demo__badge,
    .sld-demo__seg,
    .sld-demo__sparkle {
      animation: none !important;
    }

    .sld-demo__seg {
      stroke-dashoffset: 0;
    }

    .sld-demo__sparkle {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 600px) {
    .sld-demo__svg {
      width: 170px;
    }
  }
</style>

<script>
  import { observeOnce, wireReplay } from '../scripts/reveal-anim.js';

  const els = document.querySelectorAll('[data-anim="sld-demo"]');
  observeOnce(els, (el) => el.classList.add('is-in'));
  els.forEach((el) => wireReplay(el, 'is-in'));
</script>
