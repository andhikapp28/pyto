---
// Catatan: link-link di sini menunjuk ke section berlabel id pada BERANDA
// (#editor, #fitur, #bab) — bukan cuma "#editor" polos. Nav.astro dipakai
// di lebih dari satu halaman sekarang (index.astro DAN fase2/index.astro),
// dan section-section itu cuma ada di beranda. Href harus diawali
// `${base}/` supaya tetap menuju beranda + scroll ke section yang benar
// walau diklik dari halaman lain seperti /fase2/ (kalau cuma "#bab" polos,
// klik dari /fase2/ tidak melakukan apa-apa karena halaman itu tidak
// punya elemen id="bab").
const base = import.meta.env.BASE_URL;
---

<header class="nav" id="site-nav">
  <div class="container nav__inner">
    <a href={`${base}/#top`} class="nav__brand">
      <span class="nav__logo" aria-hidden="true">🐍</span>
      <span class="nav__wordmark">
        <strong>Belajar Python</strong>
        <span>Bareng Pyto</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Navigasi utama">
      <a href={`${base}/#editor`}>Editor</a>
      <a href={`${base}/#fitur`}>Kenapa Python</a>
      <a href={`${base}/#bab`}>Daftar Bab</a>
    </nav>

    <div class="nav__actions">
      <button
        type="button"
        class="nav__streak-btn"
        data-open-petualang-modal
        title="Buka Tas Petualang & Lencana"
      >
        <span class="nav__streak-flame" aria-hidden="true">🔥</span>
        <span id="nav-streak-text">1 Hari</span>
      </button>

      <button
        type="button"
        class="nav__bag-btn"
        data-open-petualang-modal
        title="Buka Tas Petualang & Lencana"
      >
        <span aria-hidden="true">🎒</span>
        <span class="nav__bag-label">Tas Petualang</span>
      </button>

      <a href={`${base}/#bab`} class="btn btn-primary nav__cta">Mulai Belajar</a>
      <button
        type="button"
        class="nav__toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav id="nav-mobile-menu" class="nav__mobile" aria-label="Navigasi mobile">
    <button type="button" class="nav__mobile-petualang" data-open-petualang-modal>
      <span>🎒 Buka Tas Petualang</span>
      <span class="nav__mobile-streak-pill" id="nav-mobile-streak">🔥 1 Hari</span>
    </button>
    <a href={`${base}/#editor`}>Editor</a>
    <a href={`${base}/#fitur`}>Kenapa Python</a>
    <a href={`${base}/#bab`}>Daftar Bab</a>
    <a href={`${base}/#bab`} class="btn btn-primary">Mulai Belajar</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(245, 248, 247, 0.75);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 76px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--pyto-green);
    font-size: 22px;
    box-shadow: 0 4px 12px rgba(47, 191, 113, 0.35);
  }

  .nav__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    font-family: var(--font-heading);
  }

  .nav__wordmark strong {
    font-size: 16px;
    font-weight: 700;
  }

  .nav__wordmark span {
    font-size: 13px;
    color: var(--pyto-green-dark);
    font-weight: 600;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 32px;
    font-weight: 700;
    font-size: 16px;
  }

  .nav__links a {
    text-decoration: none;
    color: var(--ink);
    transition: color 0.2s ease;
  }

  .nav__links a:hover {
    color: var(--pyto-green-dark);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav__streak-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    background: #fff3f0;
    border: 1px solid rgba(255, 122, 107, 0.35);
    border-radius: 999px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 13px;
    color: #c93b2b;
    cursor: pointer;
    transition: transform 0.15s, background-color 0.15s;
  }

  .nav__streak-btn:hover {
    background: #ffe6e2;
    transform: translateY(-1px);
  }

  .nav__streak-flame {
    font-size: 14px;
    display: inline-block;
    animation: flame-pulse 1.8s ease-in-out infinite;
  }

  @keyframes flame-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.18); }
  }

  .nav__bag-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: var(--pyto-green-soft);
    border: 1px solid rgba(47, 191, 113, 0.35);
    border-radius: 999px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    color: var(--pyto-green-dark);
    cursor: pointer;
    transition: transform 0.15s, background-color 0.15s;
  }

  .nav__bag-btn:hover {
    background: #d6f2e3;
    transform: translateY(-1px);
  }

  .nav__mobile-petualang {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 14px;
    background: var(--pyto-green-soft);
    border: 1px solid rgba(47, 191, 113, 0.3);
    border-radius: 10px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 14px;
    color: var(--pyto-green-dark);
    cursor: pointer;
    margin: 6px 0 10px;
  }

  .nav__mobile-streak-pill {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--white);
    font-size: 12px;
    color: #c93b2b;
  }

  .nav__cta {
    padding: 10px 22px;
    font-size: 15px;
    min-height: 40px;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .nav__toggle span {
    display: block;
    height: 3px;
    border-radius: 3px;
    background: var(--ink);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 8px 24px 20px;
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }

  .nav__mobile a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 700;
    padding: 12px 4px;
    border-bottom: 1px solid var(--border);
  }

  .nav__mobile a:last-child {
    border-bottom: none;
    margin-top: 8px;
    text-align: center;
  }

  .nav.is-open .nav__mobile {
    display: flex;
  }

  .nav.is-open .nav__toggle span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .nav.is-open .nav__toggle span:nth-child(2) {
    opacity: 0;
  }

  .nav.is-open .nav__toggle span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .nav__links {
      display: none;
    }

    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  import { getStreakData, updateDailyStreak } from '../scripts/gamification.js';

  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const navStreakText = document.getElementById('nav-streak-text');
  const navMobileStreak = document.getElementById('nav-mobile-streak');

  function syncNavStreak() {
    updateDailyStreak();
    const streak = getStreakData();
    const label = `${streak.streak} Hari`;
    if (navStreakText) navStreakText.textContent = label;
    if (navMobileStreak) navMobileStreak.textContent = `🔥 ${label}`;
  }

  syncNavStreak();

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  // Tutup menu mobile saat sebuah link diklik.
  document.querySelectorAll('.nav__mobile a').forEach((link) => {
    link.addEventListener('click', () => {
      nav?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  window.addEventListener('pyto:progress-updated', syncNavStreak);
</script>
