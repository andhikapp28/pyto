---
// Animasi #13 (plan/Fase2/bab-20-animasi.md) — penutup SELURUH Fase 2, dibangun
// mengikuti pola CurriculumCompleteBadge.astro (Bab 10, penutup kurikulum
// dasar) SEDEKAT MUNGKIN, lihat plan/Fase2/design/bab-20-desain.md ("Komponen
// Baru: Fase2CompleteBadge.astro"). Bedanya dari versi Bab 10: 10 mini-badge
// (satu per Bab 11-20, bukan 6 lencana terbatas ruang Fase 1), teks medali
// "Fase 2 Selesai!" (bukan "Selesai 10 Bab!"), dan prop
// `firstFase2ChapterHref` (ganti nama dari `firstChapterHref` supaya jelas
// ini "ulang dari AWAL FASE 2", bukan dari Bab 1). Confetti TIGA ledakan
// susulan (persis pola `bursts` CurriculumCompleteBadge), bukan satu.
interface Props {
  homeHref: string;
  firstFase2ChapterHref: string;
  // Opsional: tautan ke pengumuman Fase 3 (belum ada sama sekali saat bab ini
  // ditulis) -- echo pola fase2Href opsional di CurriculumCompleteBadge.
  // JANGAN diisi dari pemanggil untuk sekarang, komponennya sendiri tetap
  // generik/siap dipakai kalau nanti Fase 3 ada.
  fase3Href?: string;
}

const { homeHref, firstFase2ChapterHref, fase3Href } = Astro.props;

// Ikon per Bab 11-20, persis urutan "Napak Tilas Bab 11-20" di naskah.
const icons = ['🗂️', '🌐', '🖼️', '📱', '📊', '🕵️', '🎨', '🔍', '🎮', '💰'];

// 10 titik tersebar mengelilingi elips (persis pola desain CurriculumCompleteBadge,
// diperluas dari 6 ke 10 posisi supaya semua ikon kebagian tempat).
const angles = [0, 36, 72, 108, 144, 180, 216, 252, 288, 324];
const badges = icons.map((icon, i) => {
  const rad = (angles[i] * Math.PI) / 180;
  const left = 50 + 44 * Math.cos(rad);
  const top = 50 - 38 * Math.sin(rad);
  return { icon, left, top, delay: i * 0.06 };
});
---

<div class="fcb" data-anim="fcb">
  <div class="fcb__stage">
    <div class="fcb__badges" aria-hidden="true">
      {
        badges.map((b) => (
          <span
            class="fcb__mini-badge"
            style={`left:${b.left}%; top:${b.top}%; animation-delay:${b.delay}s, ${0.9 + b.delay}s;`}
          >
            {b.icon}
          </span>
        ))
      }
    </div>

    <div class="fcb__medal">
      <span class="fcb__medal-ribbon" aria-hidden="true"></span>
      <span class="fcb__medal-disc" aria-hidden="true">🏅</span>
      <p class="fcb__medal-text">Fase 2 Selesai!</p>
    </div>

    <div class="fcb__confetti" id="fcb-confetti" aria-hidden="true"></div>
  </div>

  <p class="fcb__caption">
    Ini bukan cuma "satu bab lagi selesai" — ini penutup <strong>SELURUH Fase 2</strong>, Python
    Lanjutan. Digabung dengan sepuluh bab dasar di Fase 1, kamu sekarang sudah mengumpulkan dua
    puluh alat yang benar-benar dipakai programmer sungguhan di dunia nyata: dari
    <code>print()</code> pertamamu, sampai dictionary, API, olah gambar, otomasi kantor, keamanan,
    menggambar dengan kode, dan sekarang grafik data. Selamat — Pyto benar-benar, benar-benar
    bangga sama kamu. 🎉🐍
  </p>

  <div class="fcb__cta">
    <a href={homeHref} class="btn btn-primary">🏠 Kembali ke Daftar Bab</a>
    <a href={firstFase2ChapterHref} class="btn btn-secondary">🔁 Baca Ulang dari Bab 11</a>
  </div>

  {
    fase3Href && (
      <a href={fase3Href} class="fcb__fase3-link">
        ✨ Intip Fase 3 →
      </a>
    )
  }
</div>

<style>
  .fcb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    padding: 8px 0;
  }

  .fcb__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 420px;
    height: 220px;
  }

  .fcb__badges {
    position: absolute;
    inset: 0;
  }

  .fcb__mini-badge {
    position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--pyto-green-soft);
    border: 2px solid var(--pyto-green);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    opacity: 0;
  }

  .fcb.is-in .fcb__mini-badge {
    animation-name: fcb-badge-orbit-in, fcb-badge-merge;
    animation-duration: 0.7s, 0.5s;
    animation-timing-function: ease, ease;
    animation-fill-mode: forwards, forwards;
  }

  @keyframes fcb-badge-orbit-in {
    0% {
      opacity: 0;
      transform: scale(0.5) rotate(0deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.1) rotate(180deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(360deg);
    }
  }

  @keyframes fcb-badge-merge {
    to {
      opacity: 0;
      transform: scale(0.3);
    }
  }

  .fcb__medal {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    opacity: 0;
    transform: scale(0.5);
  }

  .fcb.is-in .fcb__medal {
    animation: fcb-medal-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.3s forwards;
  }

  @keyframes fcb-medal-in {
    0% {
      opacity: 0;
      transform: scale(0.5) rotate(-15deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.15) rotate(6deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  .fcb__medal-disc {
    font-size: 68px;
    line-height: 1;
    filter: drop-shadow(0 8px 14px rgba(255, 201, 77, 0.45));
  }

  .fcb__medal-text {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 19px;
    color: var(--pyto-green-dark);
    background: var(--pyto-green-soft);
    padding: 4px 18px;
    border-radius: 999px;
  }

  .fcb__confetti {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .fcb__caption {
    max-width: 560px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }

  .fcb__caption code {
    color: var(--pyto-green-dark);
    font-weight: 700;
  }

  .fcb__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .fcb__fase3-link {
    font-weight: 700;
    font-size: 15px;
    color: var(--pyto-green-dark);
    text-decoration: none;
  }

  .fcb__fase3-link:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .fcb__mini-badge,
    .fcb__medal {
      animation: none !important;
    }

    .fcb__mini-badge {
      opacity: 0;
    }

    .fcb__medal {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .fcb__stage {
      max-width: 320px;
      height: 200px;
    }
  }
</style>

<script>
  import { observeOnce } from '../scripts/reveal-anim.js';
  import { launchConfetti } from '../scripts/confetti.js';

  observeOnce(document.querySelectorAll('[data-anim="fcb"]'), (el) => {
    el.classList.add('is-in');

    const container = el.querySelector('#fcb-confetti');
    // Penutup Fase 2 dapat perayaan setingkat penutup kurikulum dasar (Bab
    // 10): tiga ledakan susulan, bukan satu ledakan biasa.
    const bursts = [
      { delay: 1300, pieces: 46 },
      { delay: 1700, pieces: 46 },
      { delay: 2100, pieces: 46 },
    ];

    bursts.forEach(({ delay, pieces }) => {
      setTimeout(() => launchConfetti(container, { pieces }), delay);
    });
  });
</script>
