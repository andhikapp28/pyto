    <p>
      Bedah pola <code>r"[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-zA-Z]+"</code>:
    </p>
    <table class="chapter-table">
      <thead>
        <tr><th>Bagian</th><th>Artinya</th></tr>
      </thead>
      <tbody>
        {
