---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import EditorSection from '../components/EditorSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import PytoQuote from '../components/PytoQuote.astro';
import ChapterList from '../components/ChapterList.astro';
import FaqSection, { faqs } from '../components/FaqSection.astro';
import FooterCta from '../components/FooterCta.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ? Astro.site.origin : 'https://andhikapp28.github.io';
const fullUrl = `${siteUrl}${base}/`;

// Structured Data (JSON-LD): WebSite, Course, dan FAQPage
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Belajar Python Bareng Pyto',
  alternateName: ['Pyto Python', 'Tutorial Python Pyto', 'Buku Belajar Python Pyto'],
  url: fullUrl,
  inLanguage: 'id',
  description:
    'Tutorial dan buku interaktif belajar pemrograman Python dari nol untuk pemula, anak sekolah, dan guru di Indonesia. 100% gratis, langsung koding di browser.',
  publisher: {
    '@type': 'Person',
    name: 'Andhika',
    url: 'https://github.com/andhikapp28',
  },
};

const courseLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Belajar Python Bareng Pyto: Dari Nol Sampai Proyek Nyata',
  description:
    'Kursus dan tutorial interaktif belajar bahasa pemrograman Python gratis dari dasar hingga tingkat lanjut dengan editor kode langsung di browser tanpa instalasi.',
  provider: {
    '@type': 'Organization',
    name: 'Belajar Python Bareng Pyto',
    url: fullUrl,
  },
  isAccessibleForFree: true,
  inLanguage: 'id',
  educationalLevel: 'Beginner',
  teaches: [
    'Dasar Pemrograman Python',
    'Variabel dan Tipe Data',
    'Percabangan Logika if/else',
    'Perulangan Loop for dan while',
    'Struktur Data List dan Dictionary',
    'Penanganan Pesan Error dan Debugging',
    'Koneksi API Internet & Format JSON',
    'Manipulasi Gambar dengan Pillow',
    'Generator Kode QR Barcode HP',
    'Otomasi File Excel & Grafik Keuangan',
  ],
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: 'PT12H',
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout
  title="Belajar Python Bareng Pyto — Tutorial Python Pemula Gratis di Browser"
  description="Belajar ngoding Python dari nol dengan cara santai dan seru bareng Pyto, si robot ular. 100% gratis, interaktif langsung coba di browser tanpa perlu instalasi. Cocok untuk anak sekolah, pemula, dan guru."
  jsonLd={[websiteLd, courseLd, faqLd]}
>
  <Nav />
  <main>
    <Hero />
    <EditorSection />
    <FeaturesSection />
    <PytoQuote />
    <ChapterList />
    <FaqSection />
  </main>
  <FooterCta />
  <Footer />

  <script src="../scripts/reveal.js"></script>
</BaseLayout>
